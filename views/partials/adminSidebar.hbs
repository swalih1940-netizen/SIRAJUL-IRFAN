        <a class="flex-shrink-0 flex items-center gap-2 md:gap-4 px-4 py-2 md:px-5 md:py-3.5 {{#ifCond activePage 'messages'}}bg-[#fcd34d] text-[#001b3d]{{else}}text-gray-500 hover:bg-gray-50 hover:text-[#001b3d] md:hover:bg-white{{/ifCond}} rounded-xl transition-all group"
