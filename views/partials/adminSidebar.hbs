            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">photo_library</span>
            <span class="text-[13px] md:text-[15px] whitespace-nowrap">Manage Album</span>
        </a>
        <a class="flex-shrink-0 flex items-center gap-2 md:gap-4 px-4 py-2 md:px-5 md:py-3.5 {{#ifCond activePage 'videos'}}bg-[#fcd34d] text-[#001b3d]{{else}}text-gray-500 hover:bg-gray-50 hover:text-[#001b3d] md:hover:bg-white{{/ifCond}} rounded-xl transition-all group"
            href="/admin/videos">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">video_library</span>
            <span class="text-[13px] md:text-[15px] whitespace-nowrap">Manage Videos</span>
        </a>

        <!-- Mobile specific logout link inside the horizontal nav -->
        <a class="md:hidden flex-shrink-0 flex items-center gap-2 px-4 py-2 text-gray-500 hover:bg-red-50 hover:text-red-600 rounded-xl transition-all group"
