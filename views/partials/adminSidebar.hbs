<style>
    /* Hide scrollbar for Chrome, Safari and Opera */
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    /* Hide scrollbar for IE, Edge and Firefox */
    .no-scrollbar {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
    }
</style>

<aside class="fixed bottom-0 left-0 w-full bg-white shadow-[0_-4px_25px_rgba(0,0,0,0.1)] z-[60] md:flex md:flex-col md:h-screen md:w-72 md:top-20 md:shadow-none md:bg-[#f8faff] md:border-r md:border-gray-100 md:z-40 transition-all">
    <div class="hidden md:block px-6 py-4">
        <!-- Profile Box Removed as requested -->
    </div>

    <nav class="flex overflow-x-auto w-full px-4 py-3 md:flex-1 md:flex-col md:overflow-visible md:px-4 md:py-0 md:space-y-2 no-scrollbar gap-3 md:gap-0">
        <a class="flex-shrink-0 flex items-center gap-2 md:gap-4 px-4 py-2 md:px-5 md:py-3.5 {{#ifCond activePage 'dashboard'}}bg-[#fcd34d] text-[#001b3d]{{else}}text-gray-500 hover:bg-gray-50 hover:text-[#001b3d] md:hover:bg-white{{/ifCond}} rounded-xl font-bold shadow-sm transition-all"
            href="/admin">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">dashboard</span>
            <span class="text-[13px] md:text-[15px] whitespace-nowrap">Dashboard</span>
        </a>
        <a class="flex-shrink-0 flex items-center gap-2 md:gap-4 px-4 py-2 md:px-5 md:py-3.5 {{#ifCond activePage 'important-message'}}bg-[#fcd34d] text-[#001b3d]{{else}}text-gray-500 hover:bg-gray-50 hover:text-[#001b3d] md:hover:bg-white{{/ifCond}} rounded-xl transition-all group"
            href="/admin/important-message">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform text-red-500">campaign</span>
            <span class="text-[13px] md:text-[15px] whitespace-nowrap">Important Message</span>
        </a>
        <a class="flex-shrink-0 flex items-center gap-2 md:gap-4 px-4 py-2 md:px-5 md:py-3.5 {{#ifCond activePage 'users'}}bg-[#fcd34d] text-[#001b3d]{{else}}text-gray-500 hover:bg-gray-50 hover:text-[#001b3d] md:hover:bg-white{{/ifCond}} rounded-xl transition-all group"
            href="/admin/users">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">manage_accounts</span>
            <span class="text-[13px] md:text-[15px] whitespace-nowrap">Registered Accounts</span>
        </a>
        <a class="flex-shrink-0 flex items-center gap-2 md:gap-4 px-4 py-2 md:px-5 md:py-3.5 {{#ifCond activePage 'reading-corner'}}bg-[#fcd34d] text-[#001b3d]{{else}}text-gray-500 hover:bg-gray-50 hover:text-[#001b3d] md:hover:bg-white{{/ifCond}} rounded-xl transition-all group"
