<script>
    // Consolidate scroll progress logic if needed, but primary logic is in header.hbs
    // Note: scroll-progress element is in header.hbs, so logic should stay there.

    // Reveal Animations on Scroll
    const revealElements = document.querySelectorAll('.reveal');
    const revealOptions = {
        threshold: 0.15,
        rootMargin: "0px 0px -50px 0px"
    };

    const revealOnScroll = new IntersectionObserver(function(entries, observer) {
        entries.forEach(entry => {
            if (!entry.isIntersecting) {
                return;
            } else {
                entry.target.classList.add('active');
                observer.unobserve(entry.target);
            }
        });
    }, revealOptions);

    revealElements.forEach(el => {
        revealOnScroll.observe(el);
    });

    // Read More Toggle Logic
    const readMoreBtn = document.getElementById('read-more-btn');
    const extendedStory = document.getElementById('extended-story');
    const btnIcon = document.getElementById('btn-icon');
    const btnText = readMoreBtn?.querySelector('span');

    if (readMoreBtn && extendedStory) {
        readMoreBtn.addEventListener('click', () => {
            const isExpanded = extendedStory.classList.contains('max-h-[1000px]');
            if (isExpanded) {
                extendedStory.classList.remove('max-h-[1000px]', 'opacity-100');
                extendedStory.classList.add('max-h-0', 'opacity-0');
                btnText.textContent = 'Read Our Story';
                btnIcon.style.transform = 'rotate(0deg)';
            } else {
                extendedStory.classList.remove('max-h-0', 'opacity-0');
                extendedStory.classList.add('max-h-[1000px]', 'opacity-100');
                btnText.textContent = 'Read Less';
                btnIcon.style.transform = 'rotate(180deg)';
            }
        });
    }
</script>
