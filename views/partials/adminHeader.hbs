<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <!-- PWA Manifest & Theme Color -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="apple-touch-icon" href="/images/icon-512x512.png" />
    <!-- PWA Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('Service Worker registered successfully.'))
                    .catch(err => console.error('Service Worker registration failed:', err));
            });
        }
    </script>
    <title>SIRAJUL IRFAN | Perimbalam Markaz</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <meta name="keywords" content="sisa , sirajul irfan , perimbalam markaz dhars , Best islamic Institute" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#001b3d",
                        secondary: "#fcd34d",
                        background: "#f8faff"
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        
        .glass-nav {
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            background: rgba(255, 255, 255, 0.85);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
        }

        .nav-color-anim {
            background: linear-gradient(270deg, rgba(255,255,255,0.95), rgba(230,238,255,0.95), rgba(255,248,220,0.95), rgba(255,255,255,0.95));
            background-size: 400% 400%;
            animation: gradientAnim 10s ease infinite;
        }

        @keyframes gradientAnim {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .upper-navbar-class, .header-container-class {
            display: none !important;
        }
    </style>
</head>

<body class="bg-[#f8faff] text-[#001b3d] font-body-md min-h-screen transition-colors duration-300">
    <!-- Admin Top Navbar -->
    <nav id="main-nav" class="fixed top-0 right-0 left-0 h-20 glass-nav z-50 transition-all duration-300 border-b border-white/20">
        <div class="flex justify-between items-center px-10 h-full w-full">
            
            <!-- Left Side: User & Logout -->
            <div class="flex items-center gap-6">
                <!-- Logout Button -->
                <a href="/logout" class="flex items-center gap-2 text-sm font-bold text-white px-5 py-2.5 bg-gradient-to-r from-red-500 to-red-600 rounded-xl shadow-lg shadow-red-500/20 hover:shadow-red-500/40 hover:-translate-y-0.5 transition-all group active:scale-95">
                    <span class="material-symbols-outlined text-lg group-hover:-translate-x-1 transition-transform">logout</span>
                    Logout
                </a>
            </div>

            <!-- Right Side: Logo -->
            <div class="flex items-center gap-10">
                <a href="/admin" class="flex items-center gap-3 group">
                    <span class="text-xl font-bold text-[#001b3d] tracking-tight hidden lg:block">SISA Admin</span>
                    <div class="w-11 h-11 bg-white rounded-xl shadow-sm flex items-center justify-center p-2 border border-gray-100/50 group-hover:shadow-md transition-all">
                        <img src="/images/Untitled-2.png" alt="SISA" class="h-8 w-auto object-contain">
                    </div>
                </a>
            </div>
        </div>
    </nav>