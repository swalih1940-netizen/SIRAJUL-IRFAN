    <!-- Custom Sahityotsav Aesthetics Styling -->
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card {
            background: rgba(11, 17, 32, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.07);
        }

        .glass-nav {
            background: rgba(7, 10, 18, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .gradient-text-gold {
            background: linear-gradient(135deg, #fef08a 0%, #f59e0b 50%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .gradient-text-vibrant {
            background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 50%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .bg-grid-mesh {
            background-image: radial-gradient(rgba(245, 158, 11, 0.12) 1px, transparent 1px);
            background-size: 32px 32px;
        }

        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #070a12;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #f59e0b;
        }
    </style>
</head>

<body class="bg-[#070a12] text-slate-100 font-sans antialiased selection:bg-amber-500 selection:text-slate-950 overflow-x-hidden">

    <!-- Navbar -->
    <header class="fixed top-0 left-0 right-0 z-50 glass-nav border-b border-slate-800/80 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 via-amber-400 to-yellow-600 p-[2px] shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform duration-300">
                    <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
                        <span class="material-symbols-outlined text-amber-400 text-xl">auto_awesome</span>
                    </div>
                </div>
                <div class="flex flex-col">
                    <span class="font-heading font-bold text-lg tracking-wider text-white flex items-center gap-1.5">
                        SIRAJUL IRFAN <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-semibold uppercase">Fest Portal</span>
                    </span>
                    <span class="text-[10px] text-slate-400 uppercase tracking-widest font-semibold">Event Euphoria '26</span>
                </div>
            </a>

            <!-- Nav Links -->
            <nav class="hidden md:flex items-center gap-1 bg-slate-900/60 p-1.5 rounded-full border border-slate-800">
                <a href="/" class="px-4 py-2 text-xs font-semibold text-slate-300 hover:text-white rounded-full hover:bg-slate-800/60 transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-base">home</span> Main Portal
                </a>
                <a href="#countdown" class="px-4 py-2 text-xs font-semibold text-slate-300 hover:text-white rounded-full hover:bg-slate-800/60 transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-base">timer</span> Countdown
                </a>
                <a href="#houses" class="px-4 py-2 text-xs font-semibold text-slate-300 hover:text-white rounded-full hover:bg-slate-800/60 transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-base">leaderboard</span> House Standings
                </a>
                <a href="#schedule" class="px-4 py-2 text-xs font-semibold text-slate-300 hover:text-white rounded-full hover:bg-slate-800/60 transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-base">event</span> Programme
                </a>
                <a href="/results" class="px-4 py-2 text-xs font-semibold text-amber-400 hover:text-amber-300 rounded-full bg-amber-500/10 border border-amber-500/20 transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-base">emoji_events</span> Results Portal
                </a>
            </nav>

            <!-- Direct Quick Action -->
            <div class="flex items-center gap-3">
                <a href="/results" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 hover:brightness-110 active:scale-95 transition-all">
                    <span class="material-symbols-outlined text-sm">trophy</span> RESULTS
                </a>
            </div>
        </div>
    </header>

    <!-- ========================================== -->
    <!-- 1. HERO SECTION (Sahityotsav Inspired)     -->
    <!-- ========================================== -->
    <section class="relative pt-32 pb-24 md:pt-40 md:pb-32 overflow-hidden bg-grid-mesh">
        <!-- Background Ambient Glow -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-amber-500/10 blur-[130px] rounded-full pointer-events-none"></div>
        <div class="absolute top-1/3 right-10 w-[400px] h-[300px] bg-purple-500/10 blur-[140px] rounded-full pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            
            <!-- Edition Pill Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/90 border border-amber-500/30 text-amber-400 font-semibold text-xs uppercase tracking-widest mb-6 shadow-xl shadow-amber-500/5">
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                <span>26TH ANNUAL ARTS & CULTURAL FESTIVAL</span>
            </div>

            <!-- Bold Festival Title -->
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-heading font-black tracking-tight text-white mb-6 uppercase leading-tight">
                EUPHORIA <span class="gradient-text-gold">2026</span>
            </h1>

            <!-- Institution & Subtitle -->
            <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-300 font-normal leading-relaxed mb-8">
                Sirajul Irfan Da'wa Dars Flagship Cultural & Academic Competition. Celebrating talent, literary perfection, and academic excellence.
            </p>

            <!-- Date & Location Badges -->
            <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 mb-10 text-xs sm:text-sm font-semibold text-slate-300">
                <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900/80 border border-slate-800 text-amber-300">
                    <span class="material-symbols-outlined text-amber-400 text-lg">calendar_month</span>
                    <span>July 20 – 26, 2026</span>
                </div>
                <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900/80 border border-slate-800 text-slate-200">
                    <span class="material-symbols-outlined text-cyan-400 text-lg">location_on</span>
                    <span>Sirajul Irfan Campus, Kodampuzha / Perimbalam</span>
                </div>
            </div>

            <!-- Prominent Main Actions (VIEW RESULTS & PROGRAMME) -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
                <a href="/results" class="w-full sm:w-auto min-w-[200px] flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-500 text-slate-950 font-bold text-sm uppercase tracking-wider shadow-xl shadow-amber-500/25 hover:scale-[1.02] active:scale-95 transition-all">
                    <span class="material-symbols-outlined text-xl">emoji_events</span>
                    <span>VIEW RESULTS</span>
                </a>
                <a href="#schedule" class="w-full sm:w-auto min-w-[200px] flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-slate-900/90 hover:bg-slate-800 text-white font-bold text-sm uppercase tracking-wider border border-slate-700/80 hover:border-slate-500 transition-all active:scale-95">
                    <span class="material-symbols-outlined text-xl">calendar_today</span>
                    <span>PROGRAMME</span>
                </a>
            </div>

        </div>
    </section>

    <!-- ========================================== -->
    <!-- 2. COUNTDOWN TIMER SECTION                 -->
    <!-- ========================================== -->
    <section id="countdown" class="py-12 bg-slate-950/60 border-y border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row items-center justify-between gap-8">
                <div>
                    <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">FESTIVAL COUNTDOWN</span>
                    <h2 class="text-2xl font-heading font-bold text-white mt-1">Grand Finale Countdown</h2>
                </div>
                <div class="grid grid-cols-4 gap-3 sm:gap-6 text-center">
                    <div class="glass-card px-4 py-3 rounded-2xl min-w-[70px]">
                        <span id="cd-days" class="block text-2xl sm:text-3xl font-heading font-bold text-amber-400">05</span>
                        <span class="text-[10px] text-slate-400 uppercase tracking-wider">Days</span>
                    </div>
                    <div class="glass-card px-4 py-3 rounded-2xl min-w-[70px]">
                        <span id="cd-hours" class="block text-2xl sm:text-3xl font-heading font-bold text-white">14</span>
                        <span class="text-[10px] text-slate-400 uppercase tracking-wider">Hours</span>
                    </div>
                    <div class="glass-card px-4 py-3 rounded-2xl min-w-[70px]">
                        <span id="cd-mins" class="block text-2xl sm:text-3xl font-heading font-bold text-white">32</span>
                        <span class="text-[10px] text-slate-400 uppercase tracking-wider">Mins</span>
                    </div>
                    <div class="glass-card px-4 py-3 rounded-2xl min-w-[70px]">
                        <span id="cd-secs" class="block text-2xl sm:text-3xl font-heading font-bold text-cyan-400">45</span>
                        <span class="text-[10px] text-slate-400 uppercase tracking-wider">Secs</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- 3. OVERALL HOUSE STANDINGS                 -->
    <!-- ========================================== -->
    <section id="houses" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-xl mx-auto mb-16">
            <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">LIVE SCOREBOARD</span>
            <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mt-2">Overall House Standings</h2>
            <p class="text-slate-400 text-sm mt-2">Real-time aggregate points based on published competition results.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {{#if houses}}
                {{#each houses}}
                <div class="glass-card rounded-2xl p-6 relative overflow-hidden border border-slate-800 hover:border-amber-500/40 transition-all duration-300 group">
                    <div class="flex justify-between items-start mb-4">
                        <span class="text-xs font-bold px-3 py-1 rounded-full {{#if badgeClass}}{{badgeClass}}{{else}}bg-slate-800 text-slate-300{{/if}}">
                            Rank #{{this.rank}}
                        </span>
                        <span class="material-symbols-outlined text-slate-600 group-hover:text-amber-400 transition-colors">trophy</span>
                    </div>
                    <h3 class="font-heading font-bold text-xl text-white mb-1">{{this.name}}</h3>
                    <p class="text-xs text-slate-400 mb-6">Captain: {{this.captain}}</p>

                    <div class="space-y-2">
                        <div class="flex justify-between text-xs font-semibold">
                            <span class="text-slate-400">Total Points</span>
                            <span class="text-amber-400 font-bold text-lg">{{this.points}} pts</span>
                        </div>
                        <div class="w-full bg-slate-900 rounded-full h-2 overflow-hidden">
                            <div class="h-full bg-gradient-to-r {{this.barGradient}}" style="width: {{this.progress}}%"></div>
                        </div>
                    </div>
                </div>
                {{/each}}
            {{else}}
                <!-- Default Fallback House Cards -->
                <div class="glass-card rounded-2xl p-6 border border-amber-500/30">
                    <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-400 text-slate-950">Rank #1</span>
                    <h3 class="font-heading font-bold text-xl text-white mt-3 mb-1">Phoenix (Al-Anqa)</h3>
                    <p class="text-xs text-slate-400 mb-4">Captain: Irfan K.</p>
                    <div class="text-amber-400 font-bold text-2xl">1,480 pts</div>
                </div>
                <div class="glass-card rounded-2xl p-6 border border-slate-800">
                    <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-emerald-400">Rank #2</span>
                    <h3 class="font-heading font-bold text-xl text-white mt-3 mb-1">Dragon (Al-Tinnin)</h3>
                    <p class="text-xs text-slate-400 mb-4">Captain: Rayan M.</p>
                    <div class="text-emerald-400 font-bold text-2xl">1,410 pts</div>
                </div>
                <div class="glass-card rounded-2xl p-6 border border-slate-800">
                    <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-cyan-400">Rank #3</span>
                    <h3 class="font-heading font-bold text-xl text-white mt-3 mb-1">Griffin (Al-Uqab)</h3>
                    <p class="text-xs text-slate-400 mb-4">Captain: Sufiyan A.</p>
                    <div class="text-cyan-400 font-bold text-2xl">1,360 pts</div>
                </div>
                <div class="glass-card rounded-2xl p-6 border border-slate-800">
                    <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-800 text-purple-400">Rank #4</span>
                    <h3 class="font-heading font-bold text-xl text-white mt-3 mb-1">Centaur (Al-Rami)</h3>
                    <p class="text-xs text-slate-400 mb-4">Captain: Bilal T.</p>
                    <div class="text-purple-400 font-bold text-2xl">1,290 pts</div>
                </div>
            {{/if}}
        </div>
    </section>

    <!-- ========================================== -->
    <!-- 4. FESTIVAL PROGRAMME & SCHEDULE           -->
    <!-- ========================================== -->
    <section id="schedule" class="py-20 bg-slate-950/40 border-t border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
                <div>
                    <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">EVENT SCHEDULE</span>
                    <h2 class="text-3xl font-heading font-bold text-white mt-2">Festival Programme</h2>
                </div>
                <a href="/results" class="mt-4 md:mt-0 text-xs font-semibold text-amber-400 hover:underline flex items-center gap-1">
                    View Published Category Results <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Day 1 -->
                <div class="glass-card rounded-2xl p-6 border border-slate-800">
                    <div class="flex justify-between items-center pb-4 border-b border-slate-800 mb-4">
                        <span class="text-amber-400 font-bold text-sm">DAY 01</span>
                        <span class="text-xs text-slate-400">July 20, 2026</span>
                    </div>
                    <ul class="space-y-4 text-xs">
                        <li class="flex justify-between">
                            <span class="text-white font-semibold">Qira'at & Tajweed</span>
                            <span class="text-slate-400">Main Stage A</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="text-white font-semibold">Hifzul Quran</span>
                            <span class="text-slate-400">Prayer Hall</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="text-white font-semibold">Calligraphy Competition</span>
                            <span class="text-slate-400">Art Room</span>
                        </li>
                    </ul>
                </div>

                <!-- Day 2 -->
                <div class="glass-card rounded-2xl p-6 border border-slate-800">
                    <div class="flex justify-between items-center pb-4 border-b border-slate-800 mb-4">
                        <span class="text-amber-400 font-bold text-sm">DAY 02</span>
                        <span class="text-xs text-slate-400">July 22, 2026</span>
                    </div>
                    <ul class="space-y-4 text-xs">
                        <li class="flex justify-between">
                            <span class="text-white font-semibold">Elocution (English & Arabic)</span>
                            <span class="text-slate-400">Auditorium</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="text-white font-semibold">Essay Writing</span>
                            <span class="text-slate-400">Seminar Hall</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="text-white font-semibold">Islamic Quiz Round 1</span>
