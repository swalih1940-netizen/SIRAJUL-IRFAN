{{> adminHeader}}

<div class="flex w-full">
    

    <!-- Main Content -->
    <main class="pt-8 pb-12 px-4 sm:px-10 min-h-screen bg-[#f8faff] w-full">
        <!-- Header Section -->
        <header class="mb-10 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6">
            <div>
                <a href="/admin" class="inline-flex items-center gap-2 text-sm font-bold text-gray-500 hover:text-[#001b3d] mb-4 transition-colors">
                    <span class="material-symbols-outlined text-lg">arrow_back</span>
                    Back to Dashboard
                </a>
                <h1 class="text-3xl font-bold text-[#001b3d] leading-tight">Registered Accounts</h1>
                <p class="text-gray-400 font-medium mt-2 text-sm">Manage student and staff portal access accounts</p>
            </div>
            
            <div class="flex gap-4">
                <div class="flex items-center gap-4 bg-white px-5 py-3 rounded-xl border border-gray-100 shadow-sm">
                    <span class="material-symbols-outlined text-gray-400 text-lg">search</span>
                    <input type="text" placeholder="Search accounts..." class="bg-transparent border-none focus:ring-0 text-sm font-medium w-48 text-[#001b3d]">
                </div>
            </div>
        </header>

        <!-- Users List Section -->
        <section class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="p-8 border-b border-gray-50 flex items-center justify-between bg-white">
                <h3 class="text-lg font-bold text-[#001b3d] flex items-center gap-3">
                    Active Accounts
                    <span class="px-3 py-1 bg-[#f0f4f9] text-[#001b3d] text-[10px] rounded-full uppercase tracking-widest font-bold">{{users.length}} TOTAL</span>
                </h3>
                <button class="text-sm font-bold text-blue-600 hover:text-[#001b3d] transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">sync</span> Refresh Data
                </button>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-[#fafbfc] border-b border-gray-50">
                            <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Full Name</th>
                            <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Email Address</th>
                            <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Access Role</th>
                            <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Joined Date</th>
                            <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        {{#each users}}
                        <tr class="hover:bg-[#fcfdfe] transition-colors group">
                            <td class="px-8 py-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-[#001b3d] to-[#003366] text-white flex items-center justify-center font-bold text-lg shadow-sm">
                                        {{substring this.fullName 0 1}}
                                    </div>
                                    <div>
                                        <p class="font-bold text-[#001b3d] text-sm group-hover:text-blue-600 transition-colors">{{this.fullName}}</p>
                                        <p class="text-[11px] text-gray-400 font-medium">Active Member</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                <span class="text-sm font-medium text-gray-600 border-b border-gray-100 pb-1">{{this.email}}</span>
                            </td>
                            <td class="px-8 py-6">
                                <span class="px-4 py-1.5 {{#ifCond this.role 'admin'}}bg-red-50 text-red-600 border-red-100{{else}}bg-blue-50 text-blue-600 border-blue-100{{/ifCond}} rounded-xl text-[10px] font-bold uppercase tracking-widest border">
                                    {{this.role}}
                                </span>
                            </td>
                            <td class="px-8 py-6 text-sm text-gray-500 font-medium">{{formatDate this.createdAt}}</td>
                            <td class="px-8 py-6">
                                <div class="flex items-center justify-end gap-3">
                                    <button class="w-10 h-10 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:text-[#001b3d] hover:bg-white hover:shadow-sm transition-all">
                                        <span class="material-symbols-outlined text-xl">edit_square</span>
                                    </button>
                                    <form action="/admin/users/delete/{{this._id}}" method="POST" onsubmit="return confirm('Permanently delete this user account?');" class="inline">
                                        <button type="submit" class="w-10 h-10 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 transition-all">
                                            <span class="material-symbols-outlined text-xl">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                        {{#unless users}}
                        <tr>
                            <td colspan="5" class="px-8 py-24 text-center">
                                <div class="flex flex-col items-center gap-4 opacity-20">
                                    <span class="material-symbols-outlined text-7xl text-[#001b3d]">group_off</span>
                                    <p class="text-xl font-bold text-[#001b3d]">No accounts registered</p>
                                </div>
                            </td>
                        </tr>
                        {{/unless}}
                    </tbody>
                </table>
            </div>
            
            <div class="p-8 bg-[#fafbfc] border-t border-gray-50 flex items-center justify-between">
                <p class="text-sm text-gray-400 font-medium text-left">Showing <span class="text-[#001b3d] font-bold">{{users.length}}</span> portal members</p>
                <div class="flex gap-2">
                    <button class="w-10 h-10 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 disabled:opacity-50" disabled><span class="material-symbols-outlined">chevron_left</span></button>
                    <button class="w-10 h-10 rounded-lg bg-[#001b3d] text-white flex items-center justify-center font-bold text-sm shadow-md">1</button>
                    <button class="w-10 h-10 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-white transition-all"><span class="material-symbols-outlined">chevron_right</span></button>
                </div>
            </div>
        </section>
        {{> adminFooter}}
    </main>
</div>

{{! Footer moved inside main }}
