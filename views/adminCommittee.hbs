{{> adminHeader}}

<div class="flex min-h-screen bg-surface dark:bg-slate-900 pt-20 w-full">
    <main class="flex-1 p-6 md:p-10 transition-all duration-300 w-full">
        <div class="max-w-6xl mx-auto">
            <div class="mb-8">
                <a href="/admin" class="inline-flex items-center gap-2 text-sm font-bold text-gray-500 hover:text-primary mb-4 transition-colors">
                    <span class="material-symbols-outlined text-lg">arrow_back</span>
                    Back to Dashboard
                </a>
                <h1 class="text-3xl font-display-lg font-bold text-primary dark:text-white mb-2">Manage Committee</h1>
                <p class="text-body-md text-on-surface-variant dark:text-slate-400">Add or remove committee members for different years.</p>
            </div>

            {{#if success}}
            <div class="mb-6 p-4 bg-green-100 text-green-800 rounded-lg">
                {{#ifCond success 'committee_added'}}Committee added successfully.{{/ifCond}}
                {{#ifCond success 'committee_deleted'}}Committee deleted successfully.{{/ifCond}}
            </div>
            {{/if}}

            {{#if error}}
            <div class="mb-6 p-4 bg-red-100 text-red-800 rounded-lg">
                {{#ifCond error 'missing_images'}}Please upload images for all three members.{{/ifCond}}
                {{#ifCond error 'add_failed'}}Failed to add the committee.{{/ifCond}}
                {{#ifCond error 'not_found'}}Committee not found.{{/ifCond}}
                {{#ifCond error 'delete_failed'}}Failed to delete the committee.{{/ifCond}}
            </div>
            {{/if}}

            <!-- Add Section -->
            <div class="bg-surface-container-low dark:bg-slate-800 rounded-2xl p-6 mb-10 premium-shadow border border-outline-variant dark:border-slate-700">
                <h2 class="text-xl font-bold text-primary dark:text-white mb-4">Add New Committee</h2>
                <form action="/admin/committee/add" method="POST" enctype="multipart/form-data" class="flex flex-col gap-6">
                    <div class="flex flex-col md:flex-row gap-6">
                        <div class="flex-1 w-full">
                            <label class="block text-sm font-medium text-on-surface-variant dark:text-slate-300 mb-2">Year (e.g., 2026)</label>
                            <input type="text" name="year" required placeholder="2026" class="w-full px-4 py-2 rounded-lg border border-outline-variant bg-white dark:bg-slate-900 focus:ring-2 focus:ring-yellow-400 outline-none">
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-4">
                        <!-- President -->
                        <div class="p-4 border border-gray-200 rounded-xl bg-gray-50 dark:bg-slate-700/50">
                            <h3 class="font-bold text-primary dark:text-white mb-3">President</h3>
                            <label class="block text-xs font-medium text-gray-500 mb-1">Name</label>
                            <input type="text" name="presidentName" required class="w-full px-3 py-2 rounded border border-gray-300 mb-3 text-sm">
                            <label class="block text-xs font-medium text-gray-500 mb-1">Location</label>
                            <input type="text" name="presidentLocation" class="w-full px-3 py-2 rounded border border-gray-300 mb-3 text-sm">
                            <label class="block text-xs font-medium text-gray-500 mb-1">Photo</label>
                            <input type="file" name="presidentImage" accept="image/*" required class="w-full text-xs text-slate-500 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:bg-yellow-50 file:text-yellow-700 hover:file:bg-yellow-100">
                        </div>
                        
                        <!-- General Secretary -->
                        <div class="p-4 border border-gray-200 rounded-xl bg-gray-50 dark:bg-slate-700/50">
                            <h3 class="font-bold text-primary dark:text-white mb-3">General Secretary</h3>
                            <label class="block text-xs font-medium text-gray-500 mb-1">Name</label>
                            <input type="text" name="gsName" required class="w-full px-3 py-2 rounded border border-gray-300 mb-3 text-sm">
                            <label class="block text-xs font-medium text-gray-500 mb-1">Location</label>
                            <input type="text" name="gsLocation" class="w-full px-3 py-2 rounded border border-gray-300 mb-3 text-sm">
                            <label class="block text-xs font-medium text-gray-500 mb-1">Photo</label>
                            <input type="file" name="gsImage" accept="image/*" required class="w-full text-xs text-slate-500 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:bg-yellow-50 file:text-yellow-700 hover:file:bg-yellow-100">
                        </div>
                        
                        <!-- Finance Secretary -->
                        <div class="p-4 border border-gray-200 rounded-xl bg-gray-50 dark:bg-slate-700/50">
                            <h3 class="font-bold text-primary dark:text-white mb-3">Finance Secretary</h3>
                            <label class="block text-xs font-medium text-gray-500 mb-1">Name</label>
                            <input type="text" name="fsName" required class="w-full px-3 py-2 rounded border border-gray-300 mb-3 text-sm">
                            <label class="block text-xs font-medium text-gray-500 mb-1">Location</label>
                            <input type="text" name="fsLocation" class="w-full px-3 py-2 rounded border border-gray-300 mb-3 text-sm">
                            <label class="block text-xs font-medium text-gray-500 mb-1">Photo</label>
                            <input type="file" name="fsImage" accept="image/*" required class="w-full text-xs text-slate-500 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:bg-yellow-50 file:text-yellow-700 hover:file:bg-yellow-100">
                        </div>
                    </div>
                    
                    <div class="flex justify-end mt-4">
                        <button type="submit" class="px-8 py-2.5 bg-[#001b3d] text-white rounded-lg hover:bg-blue-900 transition-all font-bold shadow-md">Add Committee</button>
                    </div>
                </form>
            </div>

            <!-- Existing Committees -->
            <h2 class="text-2xl font-bold text-primary dark:text-white mb-6">Existing Committees</h2>
            <div class="space-y-6">
                {{#each committees}}
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-gray-200 shadow-sm flex flex-col md:flex-row justify-between items-center gap-6">
                    <div class="text-2xl font-black text-primary border-r border-gray-200 pr-6">{{this.year}}</div>
                    
                    <div class="flex-1 flex flex-wrap justify-around gap-4 text-center">
                        <div>
                            <img src="{{this.presidentImage}}" class="w-16 h-16 rounded-full object-cover mx-auto mb-2 border-2 border-yellow-400">
                            <p class="text-xs font-bold text-gray-500 uppercase">President</p>
                            <p class="text-sm font-semibold text-primary">{{this.presidentName}}</p>
                            {{#if this.presidentLocation}}<p class="text-[10px] text-gray-400 uppercase tracking-wide mt-0.5">{{this.presidentLocation}}</p>{{/if}}
                        </div>
                        <div>
                            <img src="{{this.gsImage}}" class="w-16 h-16 rounded-full object-cover mx-auto mb-2 border-2 border-yellow-400">
                            <p class="text-xs font-bold text-gray-500 uppercase">G. Secretary</p>
                            <p class="text-sm font-semibold text-primary">{{this.gsName}}</p>
                            {{#if this.gsLocation}}<p class="text-[10px] text-gray-400 uppercase tracking-wide mt-0.5">{{this.gsLocation}}</p>{{/if}}
                        </div>
                        <div>
                            <img src="{{this.fsImage}}" class="w-16 h-16 rounded-full object-cover mx-auto mb-2 border-2 border-yellow-400">
                            <p class="text-xs font-bold text-gray-500 uppercase">Finance Secretary</p>
                            <p class="text-sm font-semibold text-primary">{{this.fsName}}</p>
                            {{#if this.fsLocation}}<p class="text-[10px] text-gray-400 uppercase tracking-wide mt-0.5">{{this.fsLocation}}</p>{{/if}}
                        </div>
                    </div>
                    
                    <div class="pl-6 border-l border-gray-200">
                        <form action="/admin/committee/delete/{{this._id}}" method="POST" onsubmit="return confirm('Are you sure you want to delete this committee?');">
                            <button type="submit" class="text-red-500 hover:text-red-700 flex items-center justify-center p-2 rounded-full hover:bg-red-50 transition-colors" title="Delete">
                                <span class="material-symbols-outlined text-lg">delete</span>
                            </button>
                        </form>
                    </div>
                </div>
                {{else}}
                <div class="text-center py-12 bg-white dark:bg-slate-800 rounded-2xl border border-dashed border-gray-300">
                    <span class="material-symbols-outlined text-4xl mb-2 opacity-30 text-primary">groups</span>
                    <p class="text-gray-500 font-medium">No committees added yet.</p>
                </div>
                {{/each}}
            </div>
        </div>
    </main>
</div>

{{> adminFooter}}
