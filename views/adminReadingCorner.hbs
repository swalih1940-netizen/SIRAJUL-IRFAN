{{> adminHeader}}

<div class="flex w-full">
    

    <!-- Main Content -->
    <main class="pt-8 pb-28 md:pb-24 px-4 sm:px-10 min-h-screen bg-[#f8faff] w-full">
        <!-- Header Section -->
        <header class="mb-10 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6">
            <div>
                <a href="/admin" class="inline-flex items-center gap-2 text-sm font-bold text-gray-500 hover:text-[#001b3d] mb-4 transition-colors">
                    <span class="material-symbols-outlined text-lg">arrow_back</span>
                    Back to Dashboard
                </a>
                <h1 class="text-3xl font-bold text-[#001b3d] leading-tight flex items-center gap-4">
                    Content Management
                    <span class="bg-primary/5 text-primary px-3 py-1 rounded-lg text-sm font-bold border border-primary/10">
                        {{totalCount}} Total Writes
                    </span>
                </h1>
                <p class="text-gray-400 font-medium mt-2 text-sm">Review student submissions and publish literary works</p>
            </div>
            
            <div class="flex gap-4">
                <button onclick="document.getElementById('new-entry-form').scrollIntoView({behavior: 'smooth'})" class="bg-[#001b3d] px-6 py-3 rounded-xl font-bold text-sm text-white flex items-center gap-2 shadow-lg hover:shadow-[#001b3d]/20 transition-all active:scale-95">
                    <span class="material-symbols-outlined text-lg">add_circle</span> Create New Entry
                </button>
            </div>
        </header>

        <!-- Category Stats Cards -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-5">
                <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600">
                    <span class="material-symbols-outlined">menu_book</span>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Total Writes</p>
                    <h3 class="text-2xl font-bold text-[#001b3d]">{{totalCount}}</h3>
                </div>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-5">
                <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center text-green-600">
                    <span class="material-symbols-outlined">auto_stories</span>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Stories</p>
                    <h3 class="text-2xl font-bold text-[#001b3d]">{{storyCount}}</h3>
                </div>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-5">
                <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-purple-600">
                    <span class="material-symbols-outlined">edit_note</span>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Poems</p>
                    <h3 class="text-2xl font-bold text-[#001b3d]">{{poemCount}}</h3>
                </div>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-5">
                <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center text-amber-600">
                    <span class="material-symbols-outlined">article</span>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Features</p>
                    <h3 class="text-2xl font-bold text-[#001b3d]">{{featureCount}}</h3>
                </div>
            </div>
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
            <!-- Content Area (Moved to top/full width for table) -->
            <div class="lg:col-span-12 space-y-10">
                {{#if pendingEntries}}
                <!-- Moderation Queue Table -->
                <section class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
                    <div class="p-8 border-b border-gray-50 bg-[#001b3d] text-white flex items-center justify-between">
                        <div>
                            <h3 class="text-xl font-bold flex items-center gap-3">
                                <span class="material-symbols-outlined text-yellow-400">pending_actions</span>
                                Moderation Queue
                            </h3>
                            <p class="text-gray-400 text-sm mt-1">Submissions awaiting review</p>
                        </div>
                        <span class="px-4 py-1.5 bg-yellow-400 text-[#001b3d] text-[10px] font-bold rounded-full uppercase tracking-widest">{{pendingEntries.length}} New</span>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="bg-[#fafbfc] border-b border-gray-50">
                                    <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Writer Details</th>
                                    <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Category & Title</th>
                                    <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Date Submitted</th>
                                    <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                {{#each pendingEntries}}
                                <tr class="hover:bg-[#fcfdfe] transition-colors group">
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-4">
                                            <div class="w-10 h-10 rounded-xl bg-[#f0f4f9] text-[#001b3d] flex items-center justify-center font-bold text-lg">
                                                {{substring this.writerName 0 1}}
                                            </div>
                                            <div>
                                                <p class="font-bold text-[#001b3d] text-sm">{{this.writerName}}</p>
                                                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">{{#if this.writerDetails}}{{this.writerDetails}}{{else}}Student{{/if}}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6">
                                        <div class="flex flex-col gap-1">
                                            <span class="inline-block px-2 py-0.5 bg-blue-50 text-blue-600 text-[9px] font-bold rounded uppercase w-fit">{{this.type}}</span>
                                            <p class="font-bold text-[#001b3d] text-sm">{{#if this.title}}{{this.title}}{{else}}Untitled{{/if}}</p>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6 text-sm text-gray-500 font-medium">{{formatDate this.createdAt}}</td>
                                    <td class="px-8 py-6">
                                        <div class="flex items-center justify-end gap-3">
                                            <form action="/admin/reading-corner/approve/{{this._id}}" method="POST" class="inline">
                                                <button type="submit" class="w-10 h-10 rounded-lg bg-green-50 text-green-600 flex items-center justify-center hover:bg-green-600 hover:text-white transition-all shadow-sm" title="Approve">
                                                    <span class="material-symbols-outlined text-xl">verified</span>
                                                </button>
                                            </form>
                                            <button onclick="viewWork('{{this.title}}', '{{this.writerName}}', '{{this.type}}', `{{this.content}}`)" class="w-10 h-10 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:text-[#001b3d] hover:bg-white hover:shadow-sm transition-all" title="View">
                                                <span class="material-symbols-outlined text-xl">visibility</span>
                                            </button>
                                            <form action="/admin/reading-corner/delete/{{this._id}}" method="POST" onsubmit="return confirm('Reject this submission?');" class="inline">
                                                <button type="submit" class="w-10 h-10 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 transition-all" title="Reject">
                                                    <span class="material-symbols-outlined text-xl">close</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </section>
                {{/if}}

                <!-- Published Archive Table -->
                <section class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
                    <div class="p-8 border-b border-gray-50 bg-[#fafbfc] flex items-center justify-between">
                        <h3 class="text-lg font-bold text-[#001b3d] flex items-center gap-3">
                            <span class="material-symbols-outlined text-blue-600">auto_stories</span>
                            Published Archive
                        </h3>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="bg-[#fafbfc] border-b border-gray-50">
                                    <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Writer Details</th>
                                    <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Category & Title</th>
                                    <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Publish Date</th>
                                    <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                {{#each readingEntries}}
                                <tr class="hover:bg-[#fcfdfe] transition-colors group">
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-4">
                                            <div class="w-10 h-10 rounded-xl bg-[#001b3d] text-white flex items-center justify-center font-bold text-lg">
                                                {{substring this.writerName 0 1}}
                                            </div>
                                            <div>
                                                <p class="font-bold text-[#001b3d] text-sm">{{this.writerName}}</p>
                                                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">{{#if this.writerDetails}}{{this.writerDetails}}{{else}}Student Author{{/if}}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6">
                                        <div class="flex flex-col gap-1">
                                            <span class="inline-block px-2 py-0.5 bg-blue-50 text-blue-600 text-[9px] font-bold rounded uppercase w-fit">{{this.type}}</span>
                                            <p class="font-bold text-[#001b3d] text-sm">{{#if this.title}}{{this.title}}{{else}}Untitled Work{{/if}}</p>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6 text-sm text-gray-500 font-medium">{{formatDate this.createdAt}}</td>
                                    <td class="px-8 py-6">
                                        <div class="flex items-center justify-end gap-3">
                                            <button onclick="viewWork('{{this.title}}', '{{this.writerName}}', '{{this.type}}', `{{this.content}}`)" class="w-10 h-10 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:text-[#001b3d] hover:bg-white hover:shadow-sm transition-all" title="View Content">
                                                <span class="material-symbols-outlined text-xl">visibility</span>
                                            </button>
                                            <form action="/admin/reading-corner/delete/{{this._id}}" method="POST" onsubmit="return confirm('Delete this published work?');" class="inline">
                                                <button type="submit" class="w-10 h-10 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 transition-all" title="Delete">
                                                    <span class="material-symbols-outlined text-xl">delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {{else}}
                                <tr>
                                    <td colspan="4" class="px-8 py-20 text-center">
                                        <div class="flex flex-col items-center gap-4 opacity-20">
                                            <span class="material-symbols-outlined text-6xl text-[#001b3d]">menu_book</span>
                                            <p class="text-lg font-bold text-[#001b3d]">No published works yet</p>
                                        </div>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </section>

                <!-- Sticky Form Moved to Bottom/Below Archive for Better Flow -->
                <section id="new-entry-form" class="max-w-3xl mx-auto">
                    <form action="/admin/reading-corner/add" method="POST" class="bg-white p-10 rounded-3xl border border-gray-100 shadow-xl">
                        <h3 class="text-2xl font-bold text-[#001b3d] mb-8 flex items-center gap-3">
                            <span class="material-symbols-outlined text-blue-600 text-3xl">edit_note</span>
                            Publish New Work
                        </h3>
                        
                        <div class="space-y-8">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                <div>
                                    <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Writer Name</label>
                                    <input type="text" name="writerName" required placeholder="Full Name" class="w-full px-5 py-3.5 bg-[#f8faff] border-none rounded-xl focus:ring-2 focus:ring-blue-500/20 outline-none text-sm font-bold text-[#001b3d] transition-all">
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Writer Details (Optional)</label>
                                    <input type="text" name="writerDetails" placeholder="e.g. Class 10" class="w-full px-5 py-3.5 bg-[#f8faff] border-none rounded-xl focus:ring-2 focus:ring-blue-500/20 outline-none text-sm font-bold text-[#001b3d] transition-all">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                                <div>
                                    <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Category</label>
                                    <div class="grid grid-cols-3 gap-2">
                                        <label class="cursor-pointer">
                                            <input type="radio" name="type" value="Story" checked class="hidden peer">
                                            <div class="px-3 py-2.5 bg-gray-50 text-gray-400 border border-transparent rounded-xl text-[10px] font-bold text-center peer-checked:bg-[#001b3d] peer-checked:text-white transition-all uppercase">Story</div>
                                        </label>
                                        <label class="cursor-pointer">
                                            <input type="radio" name="type" value="Poem" class="hidden peer">
                                            <div class="px-3 py-2.5 bg-gray-50 text-gray-400 border border-transparent rounded-xl text-[10px] font-bold text-center peer-checked:bg-[#001b3d] peer-checked:text-white transition-all uppercase">Poem</div>
                                        </label>
                                        <label class="cursor-pointer">
                                            <input type="radio" name="type" value="Feature" class="hidden peer">
                                            <div class="px-3 py-2.5 bg-gray-50 text-gray-400 border border-transparent rounded-xl text-[10px] font-bold text-center peer-checked:bg-[#001b3d] peer-checked:text-white transition-all uppercase">Feature</div>
                                        </label>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Work Title</label>
                                    <input type="text" name="title" placeholder="Optional title..." class="w-full px-5 py-3.5 bg-[#f8faff] border-none rounded-xl focus:ring-2 focus:ring-blue-500/20 outline-none text-sm font-bold text-[#001b3d] transition-all">
                                </div>
                            </div>

                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Content (Malayalam/English)</label>
                                <textarea name="content" required rows="8" placeholder="Paste student work here..." class="w-full px-6 py-5 bg-[#f8faff] border-none rounded-2xl focus:ring-2 focus:ring-blue-500/20 outline-none text-sm font-medium text-[#001b3d] transition-all font-['Gayathri'] leading-relaxed"></textarea>
                            </div>

                            <button type="submit" class="w-full py-5 bg-[#001b3d] text-white rounded-2xl font-bold shadow-xl shadow-[#001b3d]/10 hover:shadow-[#001b3d]/30 hover:-translate-y-1 transition-all active:scale-95 flex items-center justify-center gap-3">
                                <span class="material-symbols-outlined">publish</span>
                                Publish Immediately
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        </div>
        {{> adminFooter}}
    </main>
</div>

<!-- Work Viewer Modal -->
<div id="work-modal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-6 bg-[#001b3d]/80 backdrop-blur-md">
    <div class="bg-white w-full max-w-3xl rounded-3xl shadow-2xl relative overflow-hidden animate-in fade-in zoom-in duration-300 flex flex-col max-h-[90vh]">
        <button onclick="document.getElementById('work-modal').classList.add('hidden')" class="absolute right-6 top-6 z-20 bg-white/80 backdrop-blur-sm w-10 h-10 rounded-full flex items-center justify-center text-gray-400 hover:text-[#001b3d] transition-colors border border-gray-100">
            <span class="material-symbols-outlined">close</span>
        </button>
        
        <div class="p-10 border-b border-gray-50 flex flex-col items-center text-center">
            <span id="modal-type" class="px-4 py-1 bg-blue-50 text-blue-600 text-[10px] font-bold rounded-full uppercase tracking-widest border border-blue-100 mb-4">-</span>
            <h3 id="modal-title" class="text-3xl font-bold text-[#001b3d] mb-2">-</h3>
            <p id="modal-writer" class="text-gray-400 font-bold uppercase tracking-widest text-xs">-</p>
        </div>

        <div class="p-10 overflow-y-auto flex-1 bg-[#fcfdfe]">
            <div id="modal-content" class="text-[#001b3d] font-['Gayathri'] leading-loose whitespace-pre-wrap text-lg text-justify">
                -
            </div>
        </div>

        <div class="p-8 bg-gray-50 border-t border-gray-100 flex justify-center">
            <button onclick="document.getElementById('work-modal').classList.add('hidden')" class="px-10 py-3 bg-[#001b3d] text-white rounded-xl font-bold hover:shadow-lg transition-all active:scale-95">Finished Reading</button>
        </div>
    </div>
</div>

<script>
    function viewWork(title, writer, type, content) {
        document.getElementById('modal-title').innerText = title && title !== '' ? title : 'Untitled Work';
        document.getElementById('modal-writer').innerText = 'By ' + writer;
        document.getElementById('modal-type').innerText = type;
        document.getElementById('modal-content').innerText = content;
        document.getElementById('work-modal').classList.remove('hidden');
    }
</script>

{{! Footer moved inside main }}
