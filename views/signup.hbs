<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <!-- PWA Manifest & Theme Color -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1A202C" />
    <link rel="apple-touch-icon" href="/images/icon-512x512.png" />
    <!-- PWA Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('Service Worker registered successfully.'))
                    .catch(err => console.error('Service Worker registration failed:', err));
            });
        }
    </script>
    <title>SIRAJUL IRFAN | Perimbalam Markaz</title>
    <link rel="icon" type="image/png" href="/images/logo.jpg">
    <meta name="keywords" content="sisa , sirajul irfan , perimbalam markaz dhars , Best islamic Institute" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&amp;family=Inter:wght@400;500;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary": "#ffffff",
                        "outline": "#74777f",
                        "surface-variant": "#d8e3fa",
                        "on-secondary-container": "#725a00",
                        "on-error-container": "#93000a",
                        "inverse-surface": "#263142",
                        "outline-variant": "#c4c6cf",
                        "primary-container": "#002147",
                        "surface": "#f9f9ff",
                        "primary-fixed": "#d6e3ff",
                        "secondary-fixed": "#ffe089",
                        "primary": "#000a1e",
                        "tertiary": "#090b0c",
                        "surface-container-high": "#dee8ff",
                        "on-tertiary-fixed": "#191c1d",
                        "error-container": "#ffdad6",
                        "tertiary-container": "#1f2223",
                        "on-primary-fixed-variant": "#2d476f",
                        "primary-fixed-dim": "#aec7f6",
                        "inverse-primary": "#aec7f6",
                        "on-background": "#111c2c",
                        "inverse-on-surface": "#ebf1ff",
                        "secondary-container": "#fcd353",
                        "on-error": "#ffffff",
                        "on-secondary-fixed": "#241a00",
                        "surface-container": "#e7eeff",
                        "on-surface-variant": "#44474e",
                        "surface-container-lowest": "#ffffff",
                        "surface-dim": "#cfdaf1",
                        "surface-container-low": "#f0f3ff",
                        "on-tertiary-fixed-variant": "#454748",
                        "surface-tint": "#465f88",
                        "surface-container-highest": "#d8e3fa",
                        "on-tertiary-container": "#87898a",
                        "on-surface": "#111c2c",
                        "on-secondary-fixed-variant": "#574500",
                        "error": "#ba1a1a",
                        "tertiary-fixed": "#e1e3e4",
                        "secondary-fixed-dim": "#eac243",
                        "on-primary-container": "#708ab5",
                        "surface-bright": "#f9f9ff",
                        "on-primary-fixed": "#001b3d",
                        "on-tertiary": "#ffffff",
                        "secondary": "#745b00",
                        "tertiary-fixed-dim": "#c5c7c8",
                        "on-secondary": "#ffffff",
                        "background": "#f9f9ff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "xl": "64px",
                        "container-max": "1280px",
                        "lg": "40px",
                        "gutter": "24px",
                        "sm": "12px",
                        "xs": "4px",
                        "base": "8px",
                        "margin-mobile": "16px",
                        "md": "24px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Outfit"],
                        "body-lg": ["Inter"],
                        "display-lg": ["Outfit"],
                        "body-md": ["Inter"],
                        "headline-sm": ["Outfit"],
                        "headline-md": ["Outfit"],
                        "body-sm": ["Inter"],
                        "headline-lg-mobile": ["Outfit"],
                        "label-md": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg": ["32px", { "lineHeight": "1.2", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "display-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "headline-sm": ["20px", { "lineHeight": "1.4", "fontWeight": "500" }],
                        "headline-md": ["24px", { "lineHeight": "1.3", "fontWeight": "600" }],
                        "body-sm": ["14px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "headline-lg-mobile": ["28px", { "lineHeight": "1.2", "fontWeight": "600" }],
                        "label-md": ["14px", { "lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "600" }]
                    }
                },
            },
        }
    </script>
    <style>
        .custom-shadow-level-1 {
            box-shadow: 0 4px 8px rgba(0, 33, 71, 0.06);
        }

        .form-input-focus:focus {
            outline: none;
            border-color: #745b00;
            box-shadow: 0 0 0 1px #745b00;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .animated-badge-container {
            position: relative;
            display: inline-block;
            padding: 6px 16px;
            margin-bottom: 24px;
            z-index: 1;
        }

        .badge-rect {
            position: absolute;
            inset: 0;
            background: #745b00;
            border-radius: 4px;
            z-index: -1;
            transform: scaleX(0);
            transform-origin: left;
            animation: badgeReveal 0.8s cubic-bezier(0.65, 0, 0.35, 1) forwards,
                badgeGlow 3s ease-in-out infinite 0.8s;
        }

        @keyframes badgeReveal {
            to {
                transform: scaleX(1);
            }
        }

        @keyframes badgeGlow {

            0%,
            100% {
                box-shadow: 0 0 0px rgba(116, 91, 0, 0);
            }

            50% {
                box-shadow: 0 0 15px rgba(116, 91, 0, 0.5);
            }
        }

        .badge-text {
            color: #ffffff !important;
            letter-spacing: 0.1em;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        }
    </style>
</head>

<body class="bg-surface text-on-surface font-body-md antialiased">
    <main class="min-h-screen flex flex-col md:flex-row">
        <!-- Left Side: Editorial Inspiration -->
        <section
            class="relative hidden md:flex md:w-1/2 bg-primary-container items-center justify-center p-xl overflow-hidden">
            <div class="absolute inset-0 opacity-40">
                <img alt="Dars Heritage" class="w-full h-full object-cover" src="/images/CAC02790.JPG" />
            </div>
            <div class="relative z-10 max-w-lg text-center md:text-left">
                <div class="mb-lg">
                    <div class="animated-badge-container">
                        <div class="badge-rect"></div>
                        <span class="badge-text font-headline-sm uppercase">SISA Portal</span>
                    </div>
                </div>
                <blockquote class="mb-md">
                    <p class="font-display-lg text-display-lg text-on-primary leading-tight">
                        "Welcome to the official web portal of Sirajul Irfan Dars"
                    </p>
                </blockquote>

            </div>
            <!-- Subtle Texture Overlay -->
            <div
                class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_center,_transparent_0%,_#000a1e_100%)] opacity-30">
            </div>
        </section>

        <!-- Right Side: Registration Form -->
        <section class="flex-1 flex flex-col items-center justify-center p-gutter md:p-xl bg-surface">
            <div class="w-full max-w-[480px]">
                <!-- Brand Mobile Logo -->
                <div class="md:hidden mb-lg flex justify-center">
                    <h1 class="font-headline-md text-headline-md font-bold text-primary">SISA Portal</h1>
                </div>
                <header class="mb-lg">
                    <h2 class="font-headline-lg text-headline-lg text-primary mb-xs">Begin Your Journey</h2>
                    <p class="text-on-surface-variant font-body-md">Join our prestigious community of learners and
                        scholars.</p>
                </header>

                {{#if error}}
                <div class="mb-md p-md bg-error-container text-on-error-container rounded-lg flex items-center gap-sm">
                    <span class="material-symbols-outlined">error</span>
                    <p class="font-body-sm">{{error}}</p>
                </div>
                {{/if}}

                <form action="/signup" method="POST" class="space-y-md">
                    <!-- Full Name -->
                    <div class="space-y-xs">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="fullName">Full
                            Name</label>
                        <div class="relative">
                            <span
                                class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline">person</span>
                            <input
                                class="w-full pl-[52px] pr-md py-md bg-surface-container-low border border-outline-variant rounded-lg font-body-md text-on-surface form-input-focus transition-all duration-200"
                                id="fullName" name="fullName" placeholder="Enter your full name" type="text" required />
                        </div>
                    </div>
                    <!-- Email Address -->
                    <div class="space-y-xs">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="email">Email
                            Address</label>
                        <div class="relative">
                            <span
                                class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline">mail</span>
                            <input
                                class="w-full pl-[52px] pr-md py-md bg-surface-container-low border border-outline-variant rounded-lg font-body-md text-on-surface form-input-focus transition-all duration-200"
                                id="email" name="email" placeholder="name@example.com" type="email" required />
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="space-y-xs">
                        <label class="font-label-md text-label-md text-on-surface-variant"
                            for="password">Password</label>
                        <div class="relative">
                            <span
                                class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline">lock</span>
                            <input
                                class="w-full pl-[52px] pr-xl py-md bg-surface-container-low border border-outline-variant rounded-lg font-body-md text-on-surface form-input-focus transition-all duration-200"
                                id="password" name="password" placeholder="••••••••" type="password" required />
                            <button
                                class="absolute right-md top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors"
                                type="button" id="togglePassword">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                        <!-- Password Strength Indicator -->
                        <div class="pt-xs">
                            <div class="flex gap-xs mb-xs">
                                <div class="h-1 flex-1 bg-outline-variant rounded-full transition-all duration-500"
                                    id="strength-1"></div>
                                <div class="h-1 flex-1 bg-outline-variant rounded-full transition-all duration-500"
                                    id="strength-2"></div>
                                <div class="h-1 flex-1 bg-outline-variant rounded-full transition-all duration-500"
                                    id="strength-3"></div>
                                <div class="h-1 flex-1 bg-outline-variant rounded-full transition-all duration-500"
                                    id="strength-4"></div>
                            </div>
                            <span class="font-label-md text-[10px] uppercase text-outline-variant"
                                id="strength-text">Weak</span>
                        </div>
                    </div>

                    <script>
                        const passwordInput = document.getElementById('password');
                        const toggleBtn = document.getElementById('togglePassword');
                        const strengthBars = [
                            document.getElementById('strength-1'),
                            document.getElementById('strength-2'),
                            document.getElementById('strength-3'),
                            document.getElementById('strength-4')
                        ];
                        const strengthText = document.getElementById('strength-text');

                        toggleBtn.addEventListener('click', () => {
                            const type = passwordInput.type === 'password' ? 'text' : 'password';
                            passwordInput.type = type;
                            toggleBtn.querySelector('span').textContent = type === 'password' ? 'visibility' : 'visibility_off';
                        });

                        passwordInput.addEventListener('input', (e) => {
                            const val = e.target.value;
                            let strength = 0;
                            if (val.length > 5) strength++;
                            if (val.length > 8) strength++;
                            if (/[A-Z]/.test(val)) strength++;
                            if (/[0-9]/.test(val) || /[^A-Za-z0-9]/.test(val)) strength++;

                            strengthBars.forEach((bar, i) => {
                                if (i < strength) {
                                    bar.classList.remove('bg-outline-variant');
                                    bar.classList.add('bg-secondary');
                                } else {
                                    bar.classList.add('bg-outline-variant');
                                    bar.classList.remove('bg-secondary');
                                }
                            });

                            if (strength === 0) strengthText.textContent = 'Too Short';
                            else if (strength === 1) strengthText.textContent = 'Weak';
                            else if (strength === 2) strengthText.textContent = 'Fair';
                            else if (strength === 3) strengthText.textContent = 'Good';
                            else if (strength === 4) strengthText.textContent = 'Strong';

                            if (strength > 0) strengthText.classList.replace('text-outline-variant', 'text-secondary');
                        });
                    </script>
                    <!-- TOS Checkbox -->
                    <div class="flex items-start gap-sm pt-xs">
                        <input
                            class="mt-1 h-5 w-5 rounded border-outline-variant text-secondary focus:ring-secondary cursor-pointer"
                            id="tos" name="tos" type="checkbox" required />
                        <label class="font-body-sm text-body-sm text-on-surface-variant" for="tos">
                            I agree to the <a class="text-secondary font-semibold hover:underline" href="#">Terms of
                                Service</a> and <a class="text-secondary font-semibold hover:underline" href="#">Privacy
                                Policy</a>.
                        </label>
                    </div>
                    <!-- CTA Button -->
                    <div class="pt-md">
                        <button
                            class="w-full py-md bg-secondary text-on-secondary font-headline-sm text-headline-sm rounded-lg custom-shadow-level-1 hover:bg-on-secondary-container hover:-translate-y-1 active:scale-95 transition-all duration-200 ease-in-out"
                            type="submit">
                            Create Account
                        </button>
                    </div>
                    <!-- Footer Link -->
                    <div class="pt-md text-center">
                        <p class="font-body-md text-on-surface-variant">
                            Already have an account?
                            <a class="text-primary font-bold hover:text-secondary transition-colors duration-200"
                                href="/login">Login here</a>
                        </p>
                    </div>
                </form>
                <!-- Secure Badge -->
                <div class="mt-xl flex items-center justify-center gap-xs opacity-60">
                    <span class="material-symbols-outlined text-[18px]">verified_user</span>
                    <span class="font-label-md text-[12px] uppercase tracking-wider">Enterprise-Grade Security</span>
                </div>
            </div>
        </section>
    </main>
</body>

</html>