{{> adminHeader}}
<main class="pt-24 pb-12 min-h-screen bg-[#f8faff] w-full">
    <div class="px-4 sm:px-10 py-6 sm:py-10">
        <!-- Dashboard Overview Header -->
        <header class="flex flex-col md:flex-row md:items-center justify-between mb-12 gap-6">
            <div>
                <h1 class="text-[32px] font-bold text-[#001b3d] leading-tight tracking-tight">Welcome to SISA Dashboard
                </h1>
                <p class="text-gray-400 mt-2">Manage your institution's digital ecosystem with precision.</p>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right hidden sm:block">
                    <p class="text-sm font-bold text-[#001b3d]">{{adminName}}</p>
                    <p class="text-xs text-gray-400">System Administrator</p>
                </div>
                <div
                    class="w-12 h-12 rounded-full bg-[#001b3d] text-white flex items-center justify-center font-bold shadow-lg">
                    {{substring adminName 0 1}}
                </div>
            </div>
        </header>

        <!-- Summary Cards Section -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            <!-- Total Enrollment -->
            <a href="/admin/enrollments"
                class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group block">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">Enrollments</span>
                    <div
                        class="w-12 h-12 bg-[#f0f4f9] rounded-xl flex items-center justify-center text-[#001b3d] group-hover:bg-[#001b3d] group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">group</span>
                    </div>
                </div>
                <h2 class="text-3xl font-bold text-[#001b3d]">{{totalEnrollment}}</h2>
                <div class="flex items-center justify-between mt-2">
                    <p class="text-gray-400 text-sm">Active applications</p>
                    <span
                        class="material-symbols-outlined text-gray-300 group-hover:text-secondary transition-colors">arrow_forward</span>
                </div>
            </a>

            <!-- Total Messages -->
            <a href="/admin/messages"
                class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group block">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">Inquiries</span>
                    <div
                        class="w-12 h-12 bg-yellow-50 rounded-xl flex items-center justify-center text-yellow-600 group-hover:bg-yellow-400 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">mail</span>
                    </div>
                </div>
                <h2 class="text-3xl font-bold text-[#001b3d]">{{totalMessages}}</h2>
                <div class="flex items-center justify-between mt-2">
                    <p class="text-gray-400 text-sm">Contact submissions</p>
                    <span
                        class="material-symbols-outlined text-gray-300 group-hover:text-yellow-600 transition-colors">arrow_forward</span>
                </div>
            </a>

            <!-- Writing Corner -->
            <a href="/admin/reading-corner"
                class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group block">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">Writing Corner</span>
                    <div
                        class="w-12 h-12 bg-yellow-50 rounded-xl flex items-center justify-center text-yellow-600 group-hover:bg-yellow-400 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">history_edu</span>
                    </div>
                </div>
                <h2 class="text-3xl font-bold text-[#001b3d]">{{#if total_Writes}}{{total_Writes}}{{else}}0{{/if}}</h2>
                <div class="flex items-center justify-between mt-2">
                    <p class="text-gray-400 text-sm">Total submissions</p>
                    <span
                        class="material-symbols-outlined text-gray-300 group-hover:text-yellow-600 transition-colors">arrow_forward</span>
                </div>
            </a>

            <!-- Management Committee -->
            <a href="/admin/committee"
                class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group block">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">Committee</span>
                    <div
                        class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600 group-hover:bg-[#001b3d] group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">groups</span>
                    </div>
                </div>
                <h2 class="text-3xl font-bold text-[#001b3d]">Manage</h2>
                <div class="flex items-center justify-between mt-2">
                    <p class="text-gray-400 text-sm">Leadership details</p>
                    <span
                        class="material-symbols-outlined text-gray-300 group-hover:text-[#001b3d] transition-colors">arrow_forward</span>
                </div>
            </a>

            <!-- Registered Accounts -->
            <a href="/admin/users"
                class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group block">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">Registered
                        Accounts</span>
                    <div
                        class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center text-green-600 group-hover:bg-green-600 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">person_outline</span>
                    </div>
                </div>
                <h2 class="text-3xl font-bold text-[#001b3d]">{{totalUsers}}</h2>
                <div class="flex items-center justify-between mt-2">
                    <p class="text-gray-400 text-sm">Platform members</p>
                    <span
                        class="material-symbols-outlined text-gray-300 group-hover:text-green-600 transition-colors">arrow_forward</span>
                </div>
            </a>
            <!-- Important Message -->
            <a href="/admin/important-message"
                class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group block">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">Important Message</span>
                    <div
                        class="w-12 h-12 bg-red-50 rounded-xl flex items-center justify-center text-red-600 group-hover:bg-red-600 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">campaign</span>
                    </div>
                </div>
                <h2 class="text-3xl font-bold text-[#001b3d]">Manage</h2>
                <div class="flex items-center justify-between mt-2">
                    <p class="text-gray-400 text-sm">Update frontpage banner</p>
                    <span
                        class="material-symbols-outlined text-gray-300 group-hover:text-red-600 transition-colors">arrow_forward</span>
                </div>
            </a>

            <!-- Manage Album -->
            <a href="/admin/album"
                class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group block">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">Photo Album</span>
                    <div
                        class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-purple-600 group-hover:bg-purple-600 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">photo_library</span>
                    </div>
                </div>
                <h2 class="text-3xl font-bold text-[#001b3d]">Manage</h2>
                <div class="flex items-center justify-between mt-2">
                    <p class="text-gray-400 text-sm">Gallery photos</p>
                    <span
                        class="material-symbols-outlined text-gray-300 group-hover:text-purple-600 transition-colors">arrow_forward</span>
                </div>
            </a>

            <!-- Manage Videos -->
            <a href="/admin/videos"
                class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group block">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">Videos</span>
                    <div
                        class="w-12 h-12 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">video_library</span>
                    </div>
                </div>
                <h2 class="text-3xl font-bold text-[#001b3d]">Manage</h2>
                <div class="flex items-center justify-between mt-2">
                    <p class="text-gray-400 text-sm">YouTube links</p>
                    <span
                        class="material-symbols-outlined text-gray-300 group-hover:text-indigo-600 transition-colors">arrow_forward</span>
                </div>
            </a>

            <!-- Manage Digital Magazines -->
            <a href="/admin/magazines"
                class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group block">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">Digital Magazines</span>
                    <div
                        class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center text-amber-600 group-hover:bg-amber-500 group-hover:text-slate-900 transition-colors">
                        <span class="material-symbols-outlined">auto_stories</span>
                    </div>
                </div>
                <h2 class="text-3xl font-bold text-[#001b3d]">{{#if totalMagazines}}{{totalMagazines}}{{else}}3{{/if}}</h2>
                <div class="flex items-center justify-between mt-2">
                    <p class="text-gray-400 text-sm">Flipbooks & Annual Reports</p>
                    <span
                        class="material-symbols-outlined text-gray-300 group-hover:text-amber-500 transition-colors">arrow_forward</span>
                </div>
            </a>


            <!-- Admission Status Control -->
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all block lg:col-span-3">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-gray-400 uppercase tracking-widest">Admission Control</span>
                    <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600">
                        <span class="material-symbols-outlined">school</span>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-2xl font-bold text-[#001b3d] flex items-center gap-2">
                            Admission State: 
                            {{#if admissionOpen}}
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                    ON (Admission Start)
                                </span>
                            {{else}}
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-800">
                                    <span class="w-2 h-2 rounded-full bg-gray-400"></span>
                                    OFF
                                </span>
                            {{/if}}
                        </h2>
                        <p class="text-gray-400 text-sm mt-2">When ON, a pop-up message "Admission Start" is visible at the top of the main page.</p>
                    </div>
                    <form action="/admin/settings/admission/toggle" method="POST" class="flex items-center">
                        <input type="hidden" name="isOpen" id="admissionOpenHidden" value="{{#if admissionOpen}}true{{else}}false{{/if}}">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" class="sr-only peer" onchange="document.getElementById('admissionOpenHidden').value = this.checked ? 'true' : 'false'; this.form.submit();" {{#if admissionOpen}}checked{{/if}}>
                            <div class="w-14 h-7 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-emerald-500"></div>
                        </label>
                    </form>
                </div>
            </div>

            <!-- Logout -->
            <a href="/logout"
                class="bg-red-50 p-6 rounded-2xl border border-red-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group block lg:col-span-1 lg:col-start-4">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-[12px] font-bold text-red-600 uppercase tracking-widest">System</span>
                    <div
                        class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center text-red-700 group-hover:bg-red-600 group-hover:text-white transition-colors">
                        <span class="material-symbols-outlined">logout</span>
                    </div>
                </div>
                <h2 class="text-3xl font-bold text-red-700">Logout</h2>
                <div class="flex items-center justify-between mt-2">
                    <p class="text-red-500 text-sm">End admin session</p>
                    <span
                        class="material-symbols-outlined text-red-400 group-hover:text-red-600 transition-colors">arrow_forward</span>
                </div>
            </a>
        </section>

        <!-- Main Dashboard Content Grid -->


        <!-- Recent Enrollments Table -->


    </div>
</main>

<!-- Student Details Modal -->
<div id="student-modal"
    class="fixed inset-0 z-[100] hidden flex items-center justify-center p-6 bg-[#001b3d]/60 backdrop-blur-sm">
    <div class="bg-white w-full max-w-xl rounded-3xl p-10 shadow-2xl relative animate-in fade-in zoom-in duration-300">
        <button onclick="document.getElementById('student-modal').classList.add('hidden')"
            class="absolute right-8 top-8 text-gray-400 hover:text-[#001b3d] transition-colors">
            <span class="material-symbols-outlined text-3xl">close</span>
        </button>

        <div class="flex items-center gap-6 mb-10">
            <div id="modal-avatar"
                class="w-20 h-20 rounded-2xl bg-[#001b3d] text-white flex items-center justify-center font-bold text-3xl shadow-lg">
                S</div>
            <div>
                <h3 id="modal-name" class="text-2xl font-bold text-[#001b3d]">Student Name</h3>
                <p id="modal-id" class="text-sm font-bold text-yellow-600 mt-1 uppercase tracking-widest">#ADM-0000</p>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-8 bg-[#f8faff] p-8 rounded-2xl border border-gray-100 mb-10">
            <div>
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-2">Date of
                    Birth</label>
                <p id="modal-dob" class="text-base font-bold text-[#001b3d]">-</p>
            </div>
            <div>
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-2">WhatsApp</label>
                <p id="modal-phone" class="text-base font-bold text-[#001b3d]">-</p>
            </div>
            <div class="col-span-2">
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-2">Email
                    Address</label>
                <p id="modal-email" class="text-base font-bold text-[#001b3d]">-</p>
            </div>
            <div class="col-span-2">
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-2">Residential
                    Address</label>
                <p id="modal-address" class="text-base font-bold text-[#001b3d] leading-relaxed">-</p>
            </div>
        </div>

        <div class="flex gap-4">
            <button
                class="flex-1 bg-[#001b3d] text-white py-4 rounded-xl font-bold shadow-lg hover:shadow-[#001b3d]/20 transition-all active:scale-95">Approve
                Application</button>
            <button onclick="document.getElementById('student-modal').classList.add('hidden')"
                class="flex-1 bg-gray-100 text-gray-500 py-4 rounded-xl font-bold hover:bg-gray-200 transition-all">Close</button>
        </div>
    </div>
</div>

<script>
    function viewStudent(id, name, dob, phone, email, address, prev) {
        document.getElementById('modal-name').innerText = name;
        document.getElementById('modal-id').innerText = '#ADM-' + id.substring(id.length - 6).toUpperCase();
        document.getElementById('modal-avatar').innerText = name.substring(0, 1).toUpperCase();
        document.getElementById('modal-dob').innerText = new Date(dob).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
        document.getElementById('modal-phone').innerText = phone;
        document.getElementById('modal-email').innerText = email && email !== '' ? email : 'No Email Provided';
        document.getElementById('modal-address').innerText = address;
        document.getElementById('student-modal').classList.remove('hidden');
    }
</script>

