{{> adminHeader}}

<div class="flex w-full">
    

    <!-- Main Content -->
    <main class="pt-24 pb-24 md:pb-12 px-4 sm:px-10 min-h-screen bg-[#f8faff] w-full">
        <!-- Header Section -->
        <header class="mb-10 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6">
            <div>
                <a href="/admin" class="inline-flex items-center gap-2 text-sm font-bold text-gray-500 hover:text-[#001b3d] mb-4 transition-colors">
                    <span class="material-symbols-outlined text-lg">arrow_back</span>
                    Back to Dashboard
                </a>
                <h1 class="text-3xl font-bold text-[#001b3d] leading-tight">Donations & 100 Rupee Challenge</h1>
                <p class="text-gray-400 font-medium mt-2 text-sm">Track campaign funding and export financial compliance documents</p>
            </div>
        </header>

        <!-- Summary Cards Section -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            <!-- Current Month Total -->
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">This Month's Funds</span>
                    <div class="w-10 h-10 bg-red-50 rounded-xl flex items-center justify-center text-red-600">
                        <span class="material-symbols-outlined text-lg">calendar_today</span>
                    </div>
                </div>
                <h2 class="text-2xl font-bold text-[#001b3d]">₹{{currentMonthTotal}}</h2>
                <p class="text-xs text-gray-400 mt-2">Collected in current calendar month</p>
            </div>

            <!-- Challenge Month Total -->
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">₹100 Challenge (Month)</span>
                    <div class="w-10 h-10 bg-yellow-50 rounded-xl flex items-center justify-center text-yellow-600">
                        <span class="material-symbols-outlined text-lg">volunteer_activism</span>
                    </div>
                </div>
                <h2 class="text-2xl font-bold text-[#001b3d]">₹{{challengeMonthTotal}}</h2>
                <p class="text-xs text-gray-400 mt-2">From {{challengeMonthCount}} challenge participants</p>
            </div>

            <!-- Total General Pool -->
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">General Pool (All-Time)</span>
                    <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600">
                        <span class="material-symbols-outlined text-lg">monetization_on</span>
                    </div>
                </div>
                <h2 class="text-2xl font-bold text-[#001b3d]">₹{{generalTotal}}</h2>
                <p class="text-xs text-gray-400 mt-2">Total general public contributions</p>
            </div>

            <!-- Challenge Pool (All-Time) -->
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">₹100 Challenge (All-Time)</span>
                    <div class="w-10 h-10 bg-green-50 rounded-xl flex items-center justify-center text-green-600">
                        <span class="material-symbols-outlined text-lg">savings</span>
                    </div>
                </div>
                <h2 class="text-2xl font-bold text-[#001b3d]">₹{{challengeTotal}}</h2>
                <p class="text-xs text-gray-400 mt-2">Total challenge funds raised</p>
            </div>
        </section>

        <!-- Document Export & Control Panel -->
        <section class="bg-white p-8 sm:p-10 rounded-3xl border border-gray-100 shadow-sm mb-12">
            <h3 class="text-lg font-bold text-[#001b3d] mb-6 flex items-center gap-3">
                <span class="material-symbols-outlined text-red-700">file_download</span>
                Financial Document Generator
            </h3>
            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
                <!-- Select Month -->
                <div class="lg:col-span-3 space-y-2">
                    <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block">Statement Month</label>
                    <select id="report-month" class="w-full bg-[#f8faff] p-4 rounded-xl border-none outline-none focus:ring-2 focus:ring-secondary/50 font-bold text-primary transition-all">
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                </div>

                <!-- Select Year -->
                <div class="lg:col-span-3 space-y-2">
                    <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block">Statement Year</label>
                    <select id="report-year" class="w-full bg-[#f8faff] p-4 rounded-xl border-none outline-none focus:ring-2 focus:ring-secondary/50 font-bold text-primary transition-all">
                        <option value="2026">2026</option>
                        <option value="2027">2027</option>
                        <option value="2028">2028</option>
                    </select>
                </div>

                <!-- Export Buttons -->
                <div class="lg:col-span-6 grid grid-cols-2 gap-4">
                    <!-- PDF Report Button -->
                    <button onclick="generateReport('pdf')" class="py-4 bg-[#001b3d] text-white font-bold rounded-xl shadow-lg hover:shadow-[#001b3d]/20 transition-all flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-lg">print</span>
                        Print Report
                    </button>
                    <!-- CSV Statement Button -->
                    <button onclick="generateReport('csv')" class="py-4 border-2 border-gray-100 hover:border-primary/20 text-[#001b3d] font-bold rounded-xl hover:bg-gray-50 transition-all flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-lg">download</span>
                        Export CSV
                    </button>
                </div>
            </div>
            
            <p class="text-[10px] text-gray-400 mt-6 italic">* Downloads automatically aggregate transactions matching your selected Month and Year. For annual statements, you can generate an entire calendar year's statement.</p>
        </section>

        <!-- Donors List Table -->
        <section class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="p-8 border-b border-gray-50 flex flex-col sm:flex-row items-start sm:items-center justify-between bg-white gap-6">
                <div>
                    <h3 class="text-lg font-bold text-[#001b3d] flex items-center gap-3">
                        Recent Donors & Audits
                        <span class="px-3 py-1 bg-[#f0f4f9] text-[#001b3d] text-[10px] rounded-full uppercase tracking-tighter">{{donations.length}} TOTAL</span>
                    </h3>
                    <p class="text-xs text-gray-400 mt-1">Direct listing of all public contributions and challenge signups</p>
                </div>
                <div class="flex items-center gap-4 bg-[#f8faff] px-4 py-2 rounded-xl border border-gray-100 w-full sm:w-auto">
                    <span class="material-symbols-outlined text-gray-400">search</span>
                    <input type="text" id="donation-search" onkeyup="searchDonations()" placeholder="Search donors by name..." class="bg-transparent border-none focus:ring-0 text-sm font-medium w-full sm:w-64 text-[#001b3d]">
                </div>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left" id="donations-table">
                    <thead>
                        <tr class="bg-[#fafbfc] border-b border-gray-50">
                            <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Donor Details</th>
                            <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Payment Amount</th>
                            <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Campaign / Type</th>
                            <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Payment Date</th>
                            <th class="px-8 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        {{#if donations.length}}
                            {{#each donations}}
                            <tr class="hover:bg-[#fcfdfe] transition-colors group donation-row">
                                <td class="px-8 py-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-11 h-11 rounded-xl bg-red-700/10 text-red-700 flex items-center justify-center font-bold text-lg shadow-sm">
                                            {{substring this.fullName 0 1}}
                                        </div>
                                        <div>
                                            <p class="font-bold text-[#001b3d] text-sm group-hover:text-red-700 transition-colors donor-name">{{this.fullName}}</p>
                                            <p class="text-[11px] text-gray-400 font-medium">{{this.phone}} {{#if this.email}}• {{this.email}}{{/if}}</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-8 py-6">
                                    <span class="text-sm font-bold text-slate-800">₹{{this.amount}}</span>
                                </td>
                                <td class="px-8 py-6">
                                    {{#ifCond this.type 'challenge'}}
                                        <span class="px-3 py-1 bg-yellow-100 text-yellow-800 border border-yellow-200 text-[10px] font-bold uppercase tracking-widest rounded-lg">₹100 Challenge</span>
                                    {{else}}
                                        <span class="px-3 py-1 bg-blue-50 text-blue-700 border border-blue-100 text-[10px] font-bold uppercase tracking-widest rounded-lg">General Donation</span>
                                    {{/ifCond}}
                                </td>
                                <td class="px-8 py-6 text-sm text-gray-500 font-medium">{{formatDate this.submittedAt}}</td>
                                <td class="px-8 py-6 text-right">
                                    <div class="flex items-center justify-end gap-3">
                                        <button onclick="viewDonation('{{this.fullName}}', '{{this.phone}}', '{{this.email}}', '{{this.place}}', '{{this.pincode}}', '{{this.amount}}', '{{this.type}}', '{{formatDate this.submittedAt}}', '{{this.description}}')" class="w-10 h-10 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:text-primary hover:bg-white hover:shadow-sm transition-all">
                                            <span class="material-symbols-outlined text-xl">visibility</span>
                                        </button>
                                        <form action="/admin/donations/delete/{{this._id}}" method="POST" onsubmit="return confirm('Permanently delete this transaction record?');" class="inline">
                                            <button type="submit" class="w-10 h-10 rounded-lg border border-gray-100 flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 transition-all">
                                                <span class="material-symbols-outlined text-xl">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {{/each}}
                        {{else}}
                            <tr id="empty-state">
                                <td colspan="5" class="px-8 py-20 text-center">
                                    <div class="flex flex-col items-center gap-4 opacity-20">
                                        <span class="material-symbols-outlined text-6xl text-[#001b3d]">volunteer_activism</span>
                                        <p class="text-lg font-bold text-[#001b3d]">No donations recorded yet</p>
                                    </div>
                                </td>
                            </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination area -->
            <div class="p-8 bg-[#fafbfc] border-t border-gray-50 flex items-center justify-between">
                <p class="text-sm text-gray-400 font-medium">Showing <span class="text-[#001b3d] font-bold">{{donations.length}}</span> financial records</p>
            </div>
        </section>
        {{> adminFooter}}
    </main>
</div>

<!-- Donation Details Modal -->
<div id="donation-modal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-6 bg-[#001b3d]/60 backdrop-blur-sm">
    <div class="bg-white w-full max-w-xl rounded-3xl p-10 shadow-2xl relative animate-in fade-in zoom-in duration-300">
        <button onclick="document.getElementById('donation-modal').classList.add('hidden')" class="absolute right-8 top-8 text-gray-400 hover:text-[#001b3d] transition-colors">
            <span class="material-symbols-outlined text-3xl">close</span>
        </button>
        
        <div class="flex items-center gap-6 mb-10">
            <div class="w-20 h-20 rounded-2xl bg-red-700/10 text-red-700 flex items-center justify-center font-bold text-3xl shadow-md">D</div>
            <div>
                <h3 id="modal-donor-name" class="text-2xl font-bold text-[#001b3d]">Donor Name</h3>
                <p id="modal-campaign-tag" class="text-xs font-bold text-yellow-600 mt-1 uppercase tracking-widest">-</p>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-8 bg-[#f8faff] p-8 rounded-2xl border border-gray-100 mb-10 text-left">
            <div>
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-2">Contributed Amount</label>
                <p id="modal-amount" class="text-base font-bold text-slate-800">-</p>
            </div>
            <div>
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-2">Payment Date</label>
                <p id="modal-date" class="text-base font-bold text-[#001b3d]">-</p>
            </div>
            <div>
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-2">WhatsApp Contact</label>
                <p id="modal-phone" class="text-base font-bold text-[#001b3d]">-</p>
            </div>
            <div>
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-2">Place & Pincode</label>
                <p id="modal-location" class="text-base font-bold text-[#001b3d]">-</p>
            </div>
            <div class="col-span-2">
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-2">Email Address</label>
                <p id="modal-email" class="text-base font-bold text-[#001b3d]">-</p>
            </div>
            <div class="col-span-2">
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-2">Description / Notes</label>
                <p id="modal-desc" class="text-sm font-medium text-gray-600 leading-relaxed italic">-</p>
            </div>
        </div>

        <div class="flex gap-4">
            <button onclick="document.getElementById('donation-modal').classList.add('hidden')" class="flex-grow bg-[#001b3d] text-white py-4 rounded-xl font-bold shadow-lg hover:shadow-[#001b3d]/20 transition-all active:scale-95">Close</button>
        </div>
    </div>
</div>

<script>
    // Pre-select current month/year in generator dropdowns
    document.addEventListener('DOMContentLoaded', () => {
        const currentDate = new Date();
        document.getElementById('report-month').value = currentDate.getMonth() + 1;
        document.getElementById('report-year').value = currentDate.getFullYear();
    });

    function generateReport(format) {
        const month = document.getElementById('report-month').value;
        const year = document.getElementById('report-year').value;
        
        if (format === 'pdf') {
            // Open print layout report in new tab
            window.open(`/admin/donations/report?month=${month}&year=${year}`, '_blank');
        } else if (format === 'csv') {
            // Direct download CSV
            window.location.href = `/admin/donations/download-csv?month=${month}&year=${year}`;
        }
    }

    function searchDonations() {
        const query = document.getElementById('donation-search').value.toLowerCase();
        const rows = document.querySelectorAll('.donation-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const donorName = row.querySelector('.donor-name').innerText.toLowerCase();
            if (donorName.includes(query)) {
                row.classList.remove('hidden');
                visibleCount++;
            } else {
                row.classList.add('hidden');
            }
        });

        const emptyState = document.getElementById('empty-state');
        if (visibleCount === 0 && rows.length > 0) {
            if (!emptyState) {
                const tbody = document.querySelector('#donations-table tbody');
                const tr = document.createElement('tr');
                tr.id = 'search-empty';
                tr.innerHTML = `<td colspan="5" class="px-8 py-20 text-center text-gray-400">No matching donors found</td>`;
                tbody.appendChild(tr);
            }
        } else {
            const searchEmpty = document.getElementById('search-empty');
            if (searchEmpty) searchEmpty.remove();
        }
    }

    function viewDonation(name, phone, email, place, pincode, amount, type, date, desc) {
        document.getElementById('modal-donor-name').innerText = name;
        document.getElementById('modal-campaign-tag').innerText = type === 'challenge' ? '₹100 Challenge Signup' : 'General Public Donation';
        document.getElementById('modal-amount').innerText = '₹' + amount;
        document.getElementById('modal-date').innerText = date;
        document.getElementById('modal-phone').innerText = phone;
        document.getElementById('modal-location').innerText = place + ' - ' + pincode;
        document.getElementById('modal-email').innerText = email && email !== '' ? email : 'No Email Provided';
        document.getElementById('modal-desc').innerText = desc && desc !== '' ? `"${desc}"` : 'No custom note attached.';
        
        document.getElementById('donation-modal').classList.remove('hidden');
    }
</script>
