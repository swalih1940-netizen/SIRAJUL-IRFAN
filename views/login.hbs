<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <!-- PWA Manifest & Theme Color -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="apple-touch-icon" href="/images/icon-512x512.jpg" />
    <!-- PWA Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('Service Worker registered successfully.'))
                    .catch(err => console.error('Service Worker registration failed:', err));
            });
        }
    </script>

    <title>SIRAJUL IRFAN | Perimbalam Markaz</title>
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="shortcut icon" href="/images/favicon.ico">
    <meta name="keywords" content="sisa , sirajul irfan , perimbalam markaz dhars , Best islamic Institute" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&amp;family=Inter:wght@100..900&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-primary": "#ffffff",
                        "outline": "#74777f",
                        "surface-variant": "#d8e3fa",
                        "on-secondary-container": "#725a00",
                        "on-error-container": "#93000a",
                        "inverse-surface": "#263142",
                        "outline-variant": "#c4c6cf",
                        "primary-container": "#002147",
                        "surface": "#f9f9ff",
                        "primary-fixed": "#d6e3ff",
                        "secondary-fixed": "#ffe089",
                        "primary": "#000a1e",
                        "tertiary": "#090b0c",
                        "surface-container-high": "#dee8ff",
                        "on-tertiary-fixed": "#191c1d",
                        "error-container": "#ffdad6",
                        "tertiary-container": "#1f2223",
                        "on-primary-fixed-variant": "#2d476f",
                        "primary-fixed-dim": "#aec7f6",
                        "inverse-primary": "#aec7f6",
                        "on-background": "#111c2c",
                        "inverse-on-surface": "#ebf1ff",
                        "secondary-container": "#fcd353",
                        "on-error": "#ffffff",
                        "on-secondary-fixed": "#241a00",
                        "surface-container": "#e7eeff",
                        "on-surface-variant": "#44474e",
                        "surface-container-lowest": "#ffffff",
                        "surface-dim": "#cfdaf1",
                        "surface-container-low": "#f0f3ff",
                        "on-tertiary-fixed-variant": "#454748",
                        "surface-tint": "#465f88",
                        "surface-container-highest": "#d8e3fa",
                        "on-tertiary-container": "#87898a",
                        "on-surface": "#111c2c",
                        "on-secondary-fixed-variant": "#574500",
                        "error": "#ba1a1a",
                        "tertiary-fixed": "#e1e3e4",
                        "secondary-fixed-dim": "#eac243",
                        "on-primary-container": "#708ab5",
                        "surface-bright": "#f9f9ff",
                        "on-primary-fixed": "#001b3d",
                        "on-tertiary": "#ffffff",
                        "secondary": "#745b00",
                        "tertiary-fixed-dim": "#c5c7c8",
                        "on-secondary": "#ffffff",
                        "background": "#f9f9ff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "xl": "64px",
                        "container-max": "1280px",
                        "lg": "40px",
                        "gutter": "24px",
                        "sm": "12px",
                        "xs": "4px",
                        "base": "8px",
                        "margin-mobile": "16px",
                        "md": "24px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Outfit"],
                        "body-lg": ["Inter"],
                        "display-lg": ["Outfit"],
                        "body-md": ["Inter"],
                        "headline-sm": ["Outfit"],
                        "headline-md": ["Outfit"],
                        "body-sm": ["Inter"],
                        "headline-lg-mobile": ["Outfit"],
                        "label-md": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg": ["32px", { "lineHeight": "1.2", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "display-lg": ["48px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "headline-sm": ["20px", { "lineHeight": "1.4", "fontWeight": "500" }],
                        "headline-md": ["24px", { "lineHeight": "1.3", "fontWeight": "600" }],
                        "body-sm": ["14px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "headline-lg-mobile": ["28px", { "lineHeight": "1.2", "fontWeight": "600" }],
                        "label-md": ["14px", { "lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "600" }]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
        }

        .login-split-container {
            min-height: 100vh;
            display: flex;
        }

        .login-image-side {
            flex: 1;
            position: relative;
            display: none;
        }

        @media (min-width: 1024px) {
            .login-image-side {
                display: block;
            }
        }

        .login-form-side {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .glass-overlay {
            background: rgba(0, 10, 30, 0.4);
            backdrop-filter: blur(4px);
        }
    </style>
</head>

<body class="bg-background font-body-md text-on-surface">
    <main class="login-split-container">
        <!-- Left Side: Atmospheric Academic Image -->
        <section class="login-image-side relative overflow-hidden">
            <img alt="Academic Library" class="absolute inset-0 w-full h-full object-cover"
                data-alt="A grand, historic university library with towering dark wood bookshelves reaching towards a vaulted ceiling. Soft, warm golden light streams through large arched windows, illuminating dust motes in the air and polished wooden study tables. The atmosphere is quiet, prestigious, and intellectually inspiring, utilizing a deep blue and golden color palette to reflect a heritage of excellence and focused scholarship."
                src="/images/CAC03949.jpg" />
            <div class="absolute inset-0 glass-overlay flex flex-col justify-end p-xl">
                <div class="max-w-md">
                    <span
                        class="inline-block px-base py-xs bg-secondary-container text-on-secondary-container font-label-md text-label-md rounded mb-sm">
                        ESTABLISHED 2019
                    </span>
                    <h1 class="font-display-lg text-display-lg text-on-primary mb-md">
                        Welcome Back to SISA PORTEL
                    </h1>
                    <p class="font-body-lg text-body-lg text-surface-variant opacity-90">
                        Continue your journey through the Dars Educational Portal, where tradition meets the future of
                        academic brilliance.
                    </p>
                </div>
            </div>
        </section>
        <!-- Right Side: Login Form -->
        <section class="login-form-side bg-surface">
            <div class="w-full max-w-[440px] flex flex-col gap-lg">
                <!-- Brand Header -->
                <div class="flex flex-col gap-xs items-center lg:items-start">
                    <div class="flex items-center gap-sm mb-base">
                        <span class="material-symbols-outlined text-secondary text-headline-lg"
                            style="font-variation-settings: 'FILL' 1;">auto_stories</span>
                        <span class="font-headline-md text-headline-md font-bold text-primary tracking-tight">SISA
                            Portal</span>
                    </div>
                    <h2 class="font-headline-lg text-headline-lg text-primary">SISA Administrator Sign In</h2>
                    <p class="font-body-md text-body-md text-on-surface-variant">Access your administrative portal and
                        manage student records.</p>
                </div>
                <!-- Success Message -->
                {{#if signupSuccess}}
                <div
                    class="p-md bg-secondary-container text-on-secondary-container rounded-lg flex items-center gap-sm">
                    <span class="material-symbols-outlined">check_circle</span>
                    <p class="font-body-sm">Account created successfully! Please sign in.</p>
                </div>
                {{/if}}
                {{#if error}}
                <div class="p-md bg-error-container text-on-error-container rounded-lg flex items-center gap-sm">
                    <span class="material-symbols-outlined">error</span>
                    <p class="font-body-sm">{{error}}</p>
                </div>
                {{/if}}
                <!-- Form Section -->
                <form action="/admin/login" method="POST" class="flex flex-col gap-md">
                    <!-- Email/Username -->
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-md text-label-md text-on-surface" for="identifier">Email or
                            Username</label>
                        <div class="relative">
                            <span
                                class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline">mail</span>
                            <input
                                class="w-full pl-xl pr-md py-md bg-surface-container-low border border-outline-variant rounded-lg focus:border-secondary focus:ring-1 focus:ring-secondary transition-all outline-none"
                                id="identifier" name="identifier" placeholder="Enter your email" type="text" required />
                        </div>
                    </div>
                    <!-- Password -->
                    <div class="flex flex-col gap-xs">
                        <div class="flex justify-between items-center">
                            <label class="font-label-md text-label-md text-on-surface" for="password">Password</label>
                            <a class="font-label-md text-label-md text-secondary hover:underline" href="#">Forgot
                                Password?</a>
                        </div>
                        <div class="relative">
                            <span
                                class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline">lock</span>
                            <input
                                class="w-full pl-xl pr-xl py-md bg-surface-container-low border border-outline-variant rounded-lg focus:border-secondary focus:ring-1 focus:ring-secondary transition-all outline-none"
                                id="password" name="password" placeholder="••••••••" type="password" required />
                            <button
                                class="absolute right-md top-1/2 -translate-y-1/2 text-outline hover:text-on-surface transition-colors"
                                type="button" id="togglePassword">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>
                    </div>
                    <!-- Remember Me -->
                    <div class="flex items-center gap-sm">
                        <input
                            class="w-5 h-5 rounded border-outline-variant text-secondary focus:ring-secondary cursor-pointer"
                            id="remember" name="remember" type="checkbox" />
                        <label class="font-body-sm text-body-sm text-on-surface-variant cursor-pointer"
                            for="remember">Remember me for 30 days</label>
                    </div>
                    <!-- Login Button -->
                    <button
                        class="w-full py-md bg-secondary text-on-primary font-headline-sm text-headline-sm rounded-lg shadow-[0_4px_8px_rgba(0,33,71,0.1)] hover:shadow-[0_6px_12px_rgba(0,33,71,0.15)] transform active:scale-[0.98] transition-all duration-200"
                        type="submit">
                        Sign In
                    </button>
                </form>
                <!-- Note -->
                <div
                    class="text-center mt-md p-md bg-surface-container-low rounded-lg border border-outline-variant/30">
                    <p class="font-body-sm text-body-sm text-on-surface-variant italic">
                        Authorized personnel only. Public registration is disabled.
                    </p>
                </div>
            </div>
        </section>
    </main>
    <!-- Simple Footer (Privacy/Terms) -->
    <footer class="fixed bottom-0 right-0 p-gutter hidden lg:block">
    </footer>

    <script>
        const togglePassword = document.querySelector('#togglePassword');
        const password = document.querySelector('#password');

        togglePassword.addEventListener('click', function (e) {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            this.querySelector('span').textContent = type === 'password' ? 'visibility' : 'visibility_off';
        });
    </script>
</body>

</html>