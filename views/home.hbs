    <!-- Magic Lens Blur Cursor Tracker -->
    <div id="lens-cursor"
        class="fixed top-0 left-0 w-64 h-64 rounded-full pointer-events-none mix-blend-screen z-[9999] opacity-0 transition-opacity duration-500"
        style="background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.1) 40%, rgba(255,255,255,0) 70%); filter: blur(30px); transform: translate(-50%, -50%);">
    </div>
    <script>
        const lensCursor = document.getElementById('lens-cursor');
        let mouseX = window.innerWidth / 2;
        let mouseY = window.innerHeight / 2;
        let lensX = mouseX;
        let lensY = mouseY;

        // Follow mouse
        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            lensCursor.classList.remove('opacity-0');
        });

        // Hide when mouse leaves window
        document.addEventListener('mouseleave', () => {
            lensCursor.classList.add('opacity-0');
        });

        // Smooth follow animation
        function animateLens() {
            // Easing factor (0.15 = smooth follow)
            lensX += (mouseX - lensX) * 0.15;
            lensY += (mouseY - lensY) * 0.15;

            lensCursor.style.transform = `translate3d(${lensX - 128}px, ${lensY - 128}px, 0)`;
            requestAnimationFrame(animateLens);
        }
        animateLens();

        // About Section Language Toggle & Read More
        document.addEventListener('DOMContentLoaded', () => {
            const langBtns = document.querySelectorAll('.about-lang-btn');
            const aboutEn = document.getElementById('about-en');
            const aboutAr = document.getElementById('about-ar');
            const aboutMl = document.getElementById('about-ml');

            if (langBtns.length > 0) {
                langBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const lang = btn.getAttribute('data-lang');
                        // Update buttons style
                        langBtns.forEach(b => {
                            b.classList.remove('bg-primary', 'text-white', 'shadow-sm');
                            b.classList.add('bg-gray-100', 'dark:bg-slate-800', 'text-gray-500', 'dark:text-slate-400');
                        });
                        btn.classList.remove('bg-gray-100', 'dark:bg-slate-800', 'text-gray-500', 'dark:text-slate-400');
                        btn.classList.add('bg-primary', 'text-white', 'shadow-sm');

                        // Toggle content
                        if (lang === 'en') {
                            aboutEn.classList.remove('hidden');
                            aboutAr.classList.add('hidden');
                            aboutMl.classList.add('hidden');
                        } else if (lang === 'ar') {
                            aboutEn.classList.add('hidden');
                            aboutAr.classList.remove('hidden');
                            aboutMl.classList.add('hidden');
                        } else if (lang === 'ml') {
                            aboutEn.classList.add('hidden');
                            aboutAr.classList.add('hidden');
                            aboutMl.classList.remove('hidden');
                        }
                    });
                });
            }

            // Read More Logic for English
            const readMoreEn = document.getElementById('read-more-btn-en');
            const extendedEn = document.getElementById('extended-story-en');
            if (readMoreEn && extendedEn) {
                readMoreEn.addEventListener('click', () => {
                    const isExpanded = extendedEn.classList.contains('max-h-[1000px]');
                    const btnText = readMoreEn.querySelector('span');
                    const btnIcon = document.getElementById('btn-icon-en');
                    if (isExpanded) {
                        extendedEn.classList.remove('max-h-[1000px]', 'opacity-100');
                        extendedEn.classList.add('max-h-0', 'opacity-0');
                        btnText.textContent = 'Read Our Story';
                        if (btnIcon) btnIcon.style.transform = 'rotate(0deg)';
                    } else {
                        extendedEn.classList.remove('max-h-0', 'opacity-0');
                        extendedEn.classList.add('max-h-[1000px]', 'opacity-100');
                        btnText.textContent = 'Read Less';
                        if (btnIcon) btnIcon.style.transform = 'rotate(180deg)';
                    }
                });
            }

            // Read More Logic for Arabic
            const readMoreAr = document.getElementById('read-more-btn-ar');
            const extendedAr = document.getElementById('extended-story-ar');
            if (readMoreAr && extendedAr) {
                readMoreAr.addEventListener('click', () => {
                    const isExpanded = extendedAr.classList.contains('max-h-[1000px]');
                    const btnText = readMoreAr.querySelector('span');
                    const btnIcon = document.getElementById('btn-icon-ar');
                    if (isExpanded) {
                        extendedAr.classList.remove('max-h-[1000px]', 'opacity-100');
                        extendedAr.classList.add('max-h-0', 'opacity-0');
                        btnText.textContent = 'اقرأ قصتنا';
                        if (btnIcon) btnIcon.style.transform = 'rotate(0deg)';
                    } else {
                        extendedAr.classList.remove('max-h-0', 'opacity-0');
                        extendedAr.classList.add('max-h-[1000px]', 'opacity-100');
                        btnText.textContent = 'أقرأ أقل';
                        if (btnIcon) btnIcon.style.transform = 'rotate(180deg)';
                    }
                });
            }

            // Read More Logic for Malayalam
            const readMoreMl = document.getElementById('read-more-btn-ml');
            const extendedMl = document.getElementById('extended-story-ml');
            if (readMoreMl && extendedMl) {
                readMoreMl.addEventListener('click', () => {
                    const isExpanded = extendedMl.classList.contains('max-h-[1000px]');
                    const btnText = readMoreMl.querySelector('span');
                    const btnIcon = document.getElementById('btn-icon-ml');
                    if (isExpanded) {
                        extendedMl.classList.remove('max-h-[1000px]', 'opacity-100');
                        extendedMl.classList.add('max-h-0', 'opacity-0');
                        btnText.textContent = 'കൂടുതൽ വായിക്കുക';
                        if (btnIcon) btnIcon.style.transform = 'rotate(0deg)';
                    } else {
                        extendedMl.classList.remove('max-h-0', 'opacity-0');
                        extendedMl.classList.add('max-h-[1000px]', 'opacity-100');
                        btnText.textContent = 'കുറച്ചു കാണിക്കുക';
                        if (btnIcon) btnIcon.style.transform = 'rotate(180deg)';
                    }
                });
            }
        });
    </script>
