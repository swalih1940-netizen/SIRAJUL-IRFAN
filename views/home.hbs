{{> header}}
<!-- SERVER TEST 123 -->
<main class="pt-32">
    <!-- Hero Section -->
    <section class="relative min-h-[500px] md:min-h-[819px] flex items-center bg-primary-container overflow-hidden">
        <div class="absolute inset-0 opacity-20">
            <img class="w-full h-full object-cover" data-alt="Hero Library Image" src="/images/CAC03949.jpg" />
            <div class="">
            </div>
        </div>
        <div class="relative z-10 max-w-container-max mx-auto px-gutter w-full">
            <style>
                @keyframes gradient-angle {
                    0% {
                        background-position: 0% 0%;
                    }

                    25% {
                        background-position: 100% 50%;
                    }

                    50% {
                        background-position: 100% 100%;
                    }

                    75% {
                        background-position: 0% 50%;
                    }

                    100% {
                        background-position: 0% 0%;
                    }
                }

                .animate-gradient-angle {
                    animation: gradient-angle 15s ease-in-out infinite;
                    background-size: 300% 300%;
                }

                @keyframes blur-slide-up {
                    0% {
                        transform: translateY(50px);
                        filter: blur(15px);
                        opacity: 0;
                    }

                    100% {
                        transform: translateY(0);
                        filter: blur(0);
                        opacity: 1;
                    }
                }

                .animate-blur-up-1 {
                    animation: blur-slide-up 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                }

                .animate-blur-up-2 {
                    opacity: 0;
                    animation: blur-slide-up 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
                }

                .animate-blur-up-3 {
                    opacity: 0;
                    animation: blur-slide-up 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
                }

                .animate-blur-up-4 {
                    opacity: 0;
                    animation: blur-slide-up 1.5s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
                }

                .animate-slide-up-3 {
                    opacity: 0;
                    animation: slide-in-up 1s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
                }

                .animate-slide-up-4 {
                    opacity: 0;
                    animation: slide-in-up 1s cubic-bezier(0.16, 1, 0.3, 1) 0.9s forwards;
                }

                @keyframes gradient-x {

                    0%,
                    100% {
                        background-position: 0% 50%;
                    }

                    50% {
                        background-position: 100% 50%;
                    }
                }

                .animate-gradient-x {
                    animation: gradient-x 6s ease infinite;
                    background-size: 200% auto;
                }

                @keyframes float-sub {

                    0%,
                    100% {
                        transform: translateY(0);
                        opacity: 0.9;
                    }

                    50% {
                        transform: translateY(-3px);
                        opacity: 1;
                    }
                }

                .animate-float-sub {
                    animation: float-sub 4s ease-in-out infinite;
                }

                @keyframes glow-text {

                    0%,
                    100% {
                        text-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
                    }

                    50% {
                        text-shadow: 0 0 25px rgba(255, 255, 255, 0.4);
                    }
                }

                .animate-glow-text {
                    animation: glow-text 3s ease-in-out infinite;
                }

                @keyframes reveal-width {
                    0% {
                        width: 0;
                    }

                    100% {
                        width: 100%;
                    }
                }

                @keyframes blink-cursor {

                    0%,
                    100% {
                        border-color: transparent;
                    }

                    50% {
                        border-color: rgba(255, 255, 255, 0.8);
                    }
                }
            </style>
            <div class="max-w-[800px] mx-auto flex flex-col items-center text-center relative z-20">
                <div class="flex flex-col items-center w-full">
                    <!-- Top Pill Label -->
                    <div class="animate-blur-up-1 mb-8 sm:mb-10">
                        <div
                            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md">
                            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                            <span
                                class="text-xs sm:text-xs font-semibold text-white/90 tracking-widest uppercase">Premium
                                Education Portal</span>
                        </div>
                    </div>

                    <!-- Main Headline -->
                    <div class="animate-blur-up-2 w-full flex justify-center mb-6">
                        <h1
                            class="text-[3rem] sm:text-[4rem] md:text-[5rem] lg:text-[5.5rem] font-display-lg font-black text-white leading-[1.05] tracking-tighter text-center">
                            SISA<br> Sirajul Irfan<span class="text-emerald-400">.</span>
                        </h1>
                    </div>

                    <!-- Subheadline -->
                    <div class="animate-blur-up-3 mb-10">
                        <p
                            class="text-[1.05rem] md:text-[1.15rem] font-body-lg font-normal text-[#a3a3a3] tracking-wide max-w-[650px] mx-auto leading-relaxed">
                            Sisa Markazul uloomi sunniyya. Bridging traditional wisdom with modern academic excellence
                            for the leaders of tomorrow.
                        </p>
                    </div>
                </div>

                <!-- CTA Buttons -->
                <div
                    class="w-full max-w-md sm:max-w-none mx-auto flex sm:flex-row justify-center gap-4 sm:gap-5 animate-blur-up-4 px-4 sm:px-0">
                    <a href="/admission"
                        class="px-6 sm:px-8 py-3.5 sm:py-4 bg-emerald-400 text-slate-950 text-sm sm:text-base font-body-lg font-bold rounded-full hover:bg-emerald-300 hover:shadow-[0_0_20px_rgba(52,211,153,0.3)] hover:-translate-y-1 transition-all duration-300 text-center flex items-center justify-center leading-tight shadow-md">
                        Start Admission
                    </a>
                </div>
            </div>
        </div>
    </section>


    <!-- About Section -->
