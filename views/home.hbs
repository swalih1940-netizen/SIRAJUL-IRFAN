{{> header}}
<!-- SERVER TEST 123 -->
<main class="pt-32">
    <!-- Hero Section -->
    <section class="relative min-h-[450px] sm:min-h-[500px] md:min-h-[819px] flex items-center bg-primary-container overflow-hidden py-10 sm:py-0">
        <div class="absolute inset-0 opacity-20">
            <img class="w-full h-full object-cover" data-alt="Hero Library Image" src="/images/CAC03949.jpg" />
            <div class="">
            </div>
        </div>
        <div class="relative z-10 max-w-container-max mx-auto px-4 sm:px-gutter w-full">
            <style>
                @keyframes gradient-angle {
                    0% {
                        background-position: 0% 0%;
                    }

                    25% {
                        background-position: 100% 50%;
                    }

                    50% {
                        background-position: 100% 100%;
                    }

                    75% {
                        background-position: 0% 50%;
                    }

                    100% {
                        background-position: 0% 0%;
                    }
                }

                .animate-gradient-angle {
                    animation: gradient-angle 15s ease-in-out infinite;
                    background-size: 300% 300%;
                }

                @keyframes blur-slide-up {
                    0% {
                        transform: translateY(50px);
                        filter: blur(15px);
                        opacity: 0;
                    }

                    100% {
                        transform: translateY(0);
                        filter: blur(0);
                        opacity: 1;
                    }
                }

                .animate-blur-up-1 {
                    animation: blur-slide-up 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                }

                .animate-blur-up-2 {
                    opacity: 0;
                    animation: blur-slide-up 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
                }

                .animate-blur-up-3 {
                    opacity: 0;
                    animation: blur-slide-up 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
                }

                .animate-blur-up-4 {
                    opacity: 0;
                    animation: blur-slide-up 1.5s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
                }

                .animate-slide-up-3 {
                    opacity: 0;
                    animation: slide-in-up 1s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
                }

                .animate-slide-up-4 {
                    opacity: 0;
                    animation: slide-in-up 1s cubic-bezier(0.16, 1, 0.3, 1) 0.9s forwards;
                }

                @keyframes gradient-x {

                    0%,
                    100% {
                        background-position: 0% 50%;
                    }

                    50% {
                        background-position: 100% 50%;
                    }
                }

                .animate-gradient-x {
                    animation: gradient-x 6s ease infinite;
                    background-size: 200% auto;
                }

                @keyframes float-sub {

                    0%,
                    100% {
                        transform: translateY(0);
                        opacity: 0.9;
                    }

                    50% {
                        transform: translateY(-3px);
                        opacity: 1;
                    }
                }

                .animate-float-sub {
                    animation: float-sub 4s ease-in-out infinite;
                }

                @keyframes glow-text {

                    0%,
                    100% {
                        text-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
                    }

                    50% {
                        text-shadow: 0 0 25px rgba(255, 255, 255, 0.4);
                    }
                }

                .animate-glow-text {
                    animation: glow-text 3s ease-in-out infinite;
                }

                @keyframes reveal-width {
                    0% {
                        width: 0;
                    }

                    100% {
                        width: 100%;
                    }
                }

                @keyframes blink-cursor {

                    0%,
                    100% {
                        border-color: transparent;
                    }

                    50% {
                        border-color: rgba(255, 255, 255, 0.8);
                    }
                }
            </style>
            <div class="max-w-[800px] mx-auto flex flex-col items-center text-center relative z-20">
                <div class="flex flex-col items-center w-full">
                    <!-- Top Pill Label -->
                    <div class="animate-blur-up-1 mb-5 sm:mb-10">
                        <div
                            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md">
                            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                            <span
                                class="text-[10px] sm:text-xs font-semibold text-white/90 tracking-widest uppercase">Premium
                                Education Portal</span>
                        </div>
                    </div>

                    <!-- Main Headline -->
                    <div class="animate-blur-up-2 w-full flex justify-center mb-4 sm:mb-6">
                        <h1
                            class="text-[2.25rem] sm:text-[3.75rem] md:text-[5rem] lg:text-[5.5rem] font-display-lg font-black text-white leading-[1.08] tracking-tighter text-center">
                            SISA<br> Sirajul Irfan<span class="text-emerald-400">.</span>
                        </h1>
                    </div>

                    <!-- Subheadline -->
                    <div class="animate-blur-up-3 mb-6 sm:mb-10">
                        <p
                            class="text-sm sm:text-[1.05rem] md:text-[1.15rem] font-body-lg font-normal text-[#a3a3a3] tracking-wide max-w-[650px] mx-auto leading-relaxed px-2 sm:px-0">
                            Sisa Markazul uloomi sunniyya. Bridging traditional wisdom with modern academic excellence
                            for the leaders of tomorrow.
                        </p>
                    </div>
                </div>

                <!-- CTA Buttons -->
                <div
                    class="w-full max-w-md sm:max-w-none mx-auto flex sm:flex-row justify-center gap-4 sm:gap-5 animate-blur-up-4 px-4 sm:px-0">
                    <a href="/admission"
                        class="px-6 sm:px-8 py-3 sm:py-4 bg-emerald-400 text-slate-950 text-sm sm:text-base font-body-lg font-bold rounded-full hover:bg-emerald-300 hover:shadow-[0_0_20px_rgba(52,211,153,0.3)] hover:-translate-y-1 transition-all duration-300 text-center flex items-center justify-center leading-tight shadow-md">
                        Start Admission
                    </a>
                </div>
            </div>
        </div>
    </section>


    <!-- About Section -->
    <section class="py-8 sm:py-lg max-w-container-max mx-auto px-4 sm:px-gutter reveal" id="about">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-xl items-center">
            <!-- Left Side: Text -->
            <div class="flex flex-col justify-center text-left items-start order-2 md:order-1">
                <div class="flex gap-2 mb-4 sm:mb-6" id="about-lang-toggle">
                    <button
                        class="px-3.5 py-1 sm:px-4 sm:py-1.5 text-[11px] sm:text-xs font-bold rounded-full bg-primary text-white transition-all about-lang-btn border border-transparent shadow-sm"
                        data-lang="en">ENGLISH</button>
                    <button
                        class="px-3.5 py-1 sm:px-4 sm:py-1.5 text-[11px] sm:text-xs font-bold rounded-full bg-gray-100 dark:bg-slate-800 text-gray-500 dark:text-slate-400 hover:bg-gray-200 dark:hover:bg-slate-700 transition-all about-lang-btn border border-gray-200 dark:border-slate-700"
                        data-lang="ar">ARABIC</button>
                    <button
                        class="px-3.5 py-1 sm:px-4 sm:py-1.5 text-[11px] sm:text-xs font-bold rounded-full bg-gray-100 dark:bg-slate-800 text-gray-500 dark:text-slate-400 hover:bg-gray-200 dark:hover:bg-slate-700 transition-all about-lang-btn border border-gray-200 dark:border-slate-700"
                        data-lang="ml">MALAYALAM</button>
                </div>

                <!-- English Version -->
                <div id="about-en" class="w-full transition-opacity duration-300">
                    <span
                        class="text-secondary dark:text-amber-400 font-label-md text-sm sm:text-base tracking-wider uppercase mb-1 sm:mb-sm block font-bold transition-colors">Discover
                        SISA</span>
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-display-lg font-bold text-primary dark:text-white mb-3 sm:mb-md leading-tight">
                        About</h2>
                    <p
                        class="text-base sm:text-xl md:text-2xl font-body-lg text-on-surface-variant dark:text-slate-300 mb-3 sm:mb-md leading-relaxed">
                        SIRAJUL IRFAN was founded with a noble vision of propagating Islamic knowledge, spiritual
                        enlightenment, and began its journey on Sunday, 9th June 2019, with just 14 students. Initially
                        established at Mongam, the institution now stands proudly at Perimbalam, Anakkayam, Manjeri, in
                        Malappuram district.
                    </p>
                    <p
                        class="text-base sm:text-xl md:text-2xl font-body-md text-on-surface-variant dark:text-slate-400 mb-6 sm:mb-xl leading-relaxed">
                        The institution was established under the guidance and inspiration of renowned scholars,
                        including Qalamul Islam Kodampuzha Bava Musliyar, Ahammed Darimi Ozukur, and Sayyid Jalaludheen
                        Jamalullaili Mongam. Today, it continues to flourish under the dedicated leadership of Usthad
                        Ameen Shamil Irfani Ozukur.
                    </p>
                    <div id="extended-story-en"
                        class="max-h-0 overflow-hidden transition-all duration-700 ease-in-out opacity-0">
                        <p class="text-xl md:text-2xl text-on-surface-variant dark:text-slate-400 mb-md">
                            Sirajul Irfan was established with the mission to impart authentic Islamic education,
                            nurture spiritual growth among its students, and shape individuals with strong character,
                            knowledge, and moral values for the betterment of society.
                        </p>
                        <p class="text-xl md:text-2xl text-on-surface-variant dark:text-slate-400 mb-md">
                            One of the key strengths of the institution is its spiritually uplifting environment, guided
                            by
                            the leadership of experienced scholars and teachers. Alongside academic excellence, Sirajul
                            Irfan places a deep focus on moral discipline, character building, and holistic spiritual
                            development.
                        </p>
                    </div>
                    <div class="mt-xl">
                        <button id="read-more-btn-en"
                            class="px-lg py-sm bg-primary text-white dark:bg-white dark:text-primary rounded-lg font-label-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-center gap-xs cursor-pointer">
                            <span>Read Our Story</span>
                            <span class="material-symbols-outlined transition-transform duration-300"
                                id="btn-icon-en">expand_more</span>
                        </button>
                    </div>
                </div>

                <!-- Arabic Version -->
                <div id="about-ar" class="w-full hidden transition-opacity duration-300" dir="rtl"
                    style="font-family: Arial, Tahoma, sans-serif; text-align: right;">
                    <span
                        class="text-secondary dark:text-amber-400 font-label-md text-base tracking-wider uppercase mb-sm block font-bold transition-colors">اكتشف
                        سيسا</span>
                    <h2
                        class="text-4xl md:text-6xl font-display-lg font-bold text-primary dark:text-white mb-md leading-tight">
                        معلومات عنا</h2>
                    <p
                        class="text-xl md:text-2xl font-body-lg text-on-surface-variant dark:text-slate-300 mb-md leading-relaxed">
                        تأسس سراج العرفان برؤية نبيلة لنشر المعرفة الإسلامية والتنوير الروحي، وبدأ رحلته يوم الأحد، 9
                        يونيو 2019، بـ 14 طالبًا فقط. تأسست المؤسسة في البداية في مونغام، وتقع الآن بفخر في بيريمبالام،
                        أناكيام، مانجيري، في منطقة مالابورام.
                    </p>
                    <p
                        class="text-xl md:text-2xl font-body-md text-on-surface-variant dark:text-slate-400 mb-xl leading-relaxed">
                        تم إنشاء المؤسسة بتوجيه وإلهام من علماء مشهورين، بما في ذلك قلم الإسلام كودامبوزا بافا مسليار،
                        وأحمد داريمي أوزوكور، والسيد جلال الدين جمال الليلي مونغام. وتستمر اليوم في الازدهار تحت القيادة
                        المخلصة للأستاذ أمين شامل عرفاني أوزوكور.
                    </p>
                    <div id="extended-story-ar"
                        class="max-h-0 overflow-hidden transition-all duration-700 ease-in-out opacity-0">
                        <p class="text-xl md:text-2xl text-on-surface-variant dark:text-slate-400 mb-md">
                            تأسس سراج العرفان بهدف نقل التعليم الإسلامي الأصيل، ورعاية النمو الروحي بين طلابه، وتشكيل
                            أفراد ذوي شخصية قوية ومعرفة وقيم أخلاقية من أجل تحسين المجتمع.
                        </p>
                        <p class="text-xl md:text-2xl text-on-surface-variant dark:text-slate-400 mb-md">
                            واحدة من نقاط القوة الرئيسية للمؤسسة هي بيئتها الروحية المرتفعة، بتوجيه من العلماء والمعلمين
                            ذوي الخبرة. إلى جانب التميز الأكاديمي، يركز سراج العرفان بشدة على الانضباط الأخلاقي، وبناء
                            الشخصية، والتطور الروحي الشامل.
                        </p>
                    </div>
                    <div class="mt-xl">
                        <button id="read-more-btn-ar"
                            class="px-lg py-sm bg-primary text-white dark:bg-white dark:text-primary rounded-lg font-label-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-center gap-xs cursor-pointer">
                            <span>اقرأ قصتنا</span>
                            <span class="material-symbols-outlined transition-transform duration-300"
                                id="btn-icon-ar">expand_more</span>
                        </button>
                    </div>
                </div>

                <!-- Malayalam Version -->
                <div id="about-ml" class="w-full hidden transition-opacity duration-300">
                    <span
                        class="text-secondary dark:text-amber-400 font-label-md text-base tracking-wider uppercase mb-sm block font-bold transition-colors">സിസയെ
                        കണ്ടെത്തുക</span>
                    <h2
                        class="text-4xl md:text-6xl font-display-lg font-bold text-primary dark:text-white mb-md leading-tight">
                        ഞങ്ങളെ കുറിച്ച്</h2>
                    <p
                        class="text-xl md:text-2xl font-body-lg text-on-surface-variant dark:text-slate-300 mb-md leading-relaxed">
                        ഇസ്‌ലാമിക വിജ്ഞാനവും ആത്മീയ പ്രകാശവും പ്രചരിപ്പിക്കുക എന്ന മഹത്തായ ലക്ഷ്യത്തോടെ സ്ഥാപിതമായ
                        സിറാജുൽ ഇർഫാൻ 2019 ജൂൺ 9 ഞായറാഴ്ച 14 വിദ്യാർത്ഥികളുമായി തൻ്റെ യാത്ര ആരംഭിച്ചു. മോങ്ങത്ത്
                        തുടക്കമിട്ട ഈ സ്ഥാപനം ഇപ്പോൾ മലപ്പുറം ജില്ലയിലെ മഞ്ചേരി ആനക്കയത്തെ പെരിമ്പലത്താണ് സ്ഥിതി
                        ചെയ്യുന്നത്.
                    </p>
                    <p
                        class="text-xl md:text-2xl font-body-md text-on-surface-variant dark:text-slate-400 mb-xl leading-relaxed">
                        ഖലമുൽ ഇസ്‌ലാം കോടമ്പുഴ ബാവ മുസ്‌ലിയാർ, അഹ്‌മദ്‌ ദാരിമി ഒഴുകൂർ, സയ്യിദ് ജലാലുദ്ദീൻ ജമലുല്ലൈലി
                        മോങ്ങം തുടങ്ങിയ പ്രഗത്ഭരായ പണ്ഡിതരുടെ മാർഗനിർദേശത്തിനും പ്രചോദനത്തിനും കീഴിലാണ് ഈ സ്ഥാപനം
                        സ്ഥാപിതമായത്. ഉസ്താദ് അമീൻ ഷാമിൽ ഇർഫാനി ഒഴുകൂറിൻ്റെ സമർപ്പിത നേതൃത്വത്തിന് കീഴിൽ ഇന്ന് അത്
                        അഭിവൃദ്ധി പ്രാപിച്ചുകൊണ്ടിരിക്കുന്നു.
                    </p>
                    <div id="extended-story-ml"
                        class="max-h-0 overflow-hidden transition-all duration-700 ease-in-out opacity-0">
                        <p class="text-xl md:text-2xl text-on-surface-variant dark:text-slate-400 mb-md">
                            ആധികാരികമായ ഇസ്‌ലാമിക വിദ്യാഭ്യാസം പകർന്നുനൽകുക, വിദ്യാർത്ഥികൾക്കിടയിൽ ആത്മീയ വളർച്ചയെ
                            പരിപോഷിപ്പിക്കുക, സമൂഹത്തിൻ്റെ ഉന്നമനത്തിനായി ശക്തമായ സ്വഭാവവും അറിവും ധാർമ്മിക
                            മൂല്യങ്ങളുമുള്ള വ്യക്തികളെ രൂപപ്പെടുത്തുക എന്ന ദൗത്യത്തോടെയാണ് സിറാജുൽ ഇർഫാൻ സ്ഥാപിതമായത്.
                        </p>
                        <p class="text-xl md:text-2xl text-on-surface-variant dark:text-slate-400 mb-md">
                            പരിചയസമ്പന്നരായ പണ്ഡിതന്മാരുടെയും അധ്യാപകരുടെയും നേതൃത്വത്താൽ നയിക്കപ്പെടുന്ന, ആത്മീയമായി
                            ഉത്തേജിപ്പിക്കുന്ന അന്തരീക്ഷമാണ് ഈ സ്ഥാപനത്തിൻ്റെ പ്രധാന കരുത്തുകളിലൊന്ന്. അക്കാദമിക
                            മികവിനൊപ്പം, ധാർമ്മിക അച്ചടക്കം, സ്വഭാവ രൂപീകരണം, സമഗ്രമായ ആത്മീയ വികസനം എന്നിവയിൽ സിറാജുൽ
                            ഇർഫാൻ ആഴത്തിൽ ശ്രദ്ധ കേന്ദ്രീകരിക്കുന്നു.
                        </p>
                    </div>
                    <div class="mt-xl">
                        <button id="read-more-btn-ml"
                            class="px-lg py-sm bg-primary text-white dark:bg-white dark:text-primary rounded-lg font-label-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-center gap-xs">
                            <span>കൂടുതൽ വായിക്കുക</span>
                            <span class="material-symbols-outlined transition-transform duration-300"
                                id="btn-icon-ml">expand_more</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Side: Image -->
            <div
                class="h-[400px] md:h-[500px] w-full rounded-2xl overflow-hidden premium-shadow relative group order-1 md:order-2">
                <div
                    class="absolute inset-0 bg-secondary/10 group-hover:bg-transparent transition-colors duration-500 z-10">
                </div>
                <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-in-out"
                    src="/images/CAC02790.JPG" alt="Students at SIRAJUL IRFAN" />
            </div>
        </div>
    </section>

    <!-- Manager Section -->
    <section class="py-8 sm:py-xl bg-surface-container-low dark:bg-slate-900/40 overflow-hidden relative reveal">
        <!-- Background decorative elements -->
        <div
            class="absolute top-0 right-0 w-64 h-64 bg-secondary/10 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-pulse-slow">
        </div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary/10 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-pulse-slow"
            style="animation-delay: 2s;"></div>

        <div class="max-w-container-max mx-auto px-4 sm:px-gutter relative z-10">
            <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-20">
                <!-- Image Column -->
                <div class="w-full lg:w-5/12 relative group">
                    <div
                        class="absolute inset-0 bg-gradient-to-tr from-secondary/40 to-primary/40 rounded-2xl sm:rounded-[2rem] transform rotate-3 group-hover:rotate-6 transition-transform duration-500 blur-xl opacity-50">
                    </div>
                    <div
                        class="relative h-[320px] sm:h-[400px] md:h-[500px] w-full rounded-2xl sm:rounded-[2rem] overflow-hidden border-2 border-white/20 premium-shadow bg-white/5 backdrop-blur-sm">
                        <img class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-in-out"
                            src="/images/abodut-Image.jpg" alt="Manager of Sirajul Irfan" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent">
                        </div>
                    </div>
                    <!-- Floating Badge -->
                    <div
                        class="absolute -bottom-4 -right-2 sm:-bottom-6 sm:-right-6 bg-white dark:bg-slate-800 p-3 sm:p-4 rounded-xl sm:rounded-2xl premium-shadow border border-outline-variant dark:border-slate-700 animate-float">
                        <span
                            class="material-symbols-outlined text-2xl sm:text-4xl text-secondary dark:text-amber-400">workspace_premium</span>
                    </div>
                </div>

                <!-- Text Column -->
                <div class="w-full lg:w-7/12 flex flex-col justify-center text-left items-start">
                    <div class="inline-flex items-center gap-2 mb-3 sm:mb-4">
                        <span class="h-[2px] w-8 sm:w-12 bg-secondary dark:bg-amber-400 rounded-full"></span>
                        <span
                            class="text-secondary dark:text-amber-400 font-label-md tracking-widest uppercase text-xs sm:text-base font-bold">Honorable
                            Manager</span>
