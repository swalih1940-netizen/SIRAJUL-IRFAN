            <script>
                const scrollContainer = document.getElementById('committee-scroll');
                const slides = document.querySelectorAll('.committee-slide');

                // Intersection Observer to detect which slide is in the center
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        const badge = entry.target.querySelector('.year-badge');
                        if (entry.isIntersecting) {
                            entry.target.classList.add('active-slide');
                            entry.target.classList.remove('opacity-40', 'scale-90', 'blur-[2px]');
                            entry.target.classList.add('opacity-100', 'scale-100', 'blur-none');
                            if (badge) {
                                badge.classList.remove('bg-[#001b3d]');
                                badge.classList.add('bg-green-600', 'border-green-400');
                            }
                        } else {
                            entry.target.classList.remove('active-slide', 'opacity-100', 'scale-100', 'blur-none');
                            entry.target.classList.add('opacity-40', 'scale-90', 'blur-[2px]');
                            if (badge) {
                                badge.classList.remove('bg-green-600', 'border-green-400');
                                badge.classList.add('bg-[#001b3d]');
                            }
                        }
                    });
                }, {
                    root: scrollContainer,
                    threshold: 0.3 // Slide is active when 30% is visible, ensures mobile triggers reliably
                });

                if (slides.length > 0) {
                    slides.forEach(slide => observer.observe(slide));

                    // Auto-scroll to the active committee on load
                    setTimeout(() => {
                        const activeCommitteeSlide = Array.from(slides).find(s => s.getAttribute('data-is-active') === 'true');
                        if (activeCommitteeSlide) {
                            scrollContainer.scrollTo({
                                left: activeCommitteeSlide.offsetLeft - (scrollContainer.clientWidth - activeCommitteeSlide.clientWidth) / 2,
                                behavior: 'smooth'
                            });
                        } else {
                            scrollContainer.scrollTo({
                                left: scrollContainer.scrollWidth,
                                behavior: 'smooth'
                            });
                        }
                    }, 800); // Small delay to let the pop animation start before scrolling
                }

                // Pop animation for the whole management section
                const mgmtSection = document.getElementById('management-section');
                if (mgmtSection) {
                    const popObserver = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                entry.target.classList.remove('opacity-0', 'scale-95');
                                entry.target.classList.add('opacity-100', 'scale-100');
                                popObserver.unobserve(entry.target);
                            }
                        });
                    }, { threshold: 0.15 });
                    popObserver.observe(mgmtSection);
                }

                function scrollCommittee(direction) {
                    if (!scrollContainer) return;
                    const scrollAmount = scrollContainer.clientWidth * 0.7; // Roughly the width of one slide
                    if (direction === 'left') {
                        scrollContainer.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                    } else {
                        scrollContainer.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                    }
                }
            </script>
            {{/if}}
