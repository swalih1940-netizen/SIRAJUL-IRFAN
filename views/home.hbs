    <!-- Reading Corner Section -->
    <section class="py-lg bg-surface-container-low dark:bg-slate-900/40 overflow-hidden reveal">
        <div class="max-w-container-max mx-auto px-gutter text-left md:text-center mb-xl" id="reading-corner-header">
            <span class="text-secondary font-label-md text-base tracking-wider uppercase mb-sm block">Student
                Creations</span>
            <h2 class="text-4xl md:text-6xl font-display-lg font-bold text-primary dark:text-white mb-4">Writing Corner
            </h2>
            <p class="text-xl md:text-2xl text-on-surface-variant max-w-xl md:mx-auto mt-2 leading-relaxed">Explore
                stories, poems, and features
                written by our talented students.</p>
        </div>

        <div class="max-w-container-max mx-auto px-gutter">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-lg">
                {{#each latestEntries}}
                <div
                    class="bg-white dark:bg-slate-800 p-6 sm:p-lg rounded-2xl border border-outline-variant dark:border-slate-700 premium-shadow flex flex-col h-full group hover:-translate-y-2 transition-all duration-300">
                    <div class="flex items-center justify-between mb-md">
                        <span
                            class="px-3 py-1 {{#ifCond this.type 'Story'}}bg-primary/10 text-primary{{/ifCond}} {{#ifCond this.type 'Poem'}}bg-secondary/10 text-secondary{{/ifCond}} {{#ifCond this.type 'Feature'}}bg-primary-container/10 text-primary-container{{/ifCond}} text-[10px] font-bold uppercase tracking-widest rounded-full">
                            {{#ifCond this.type 'Story'}}Story | കഥ{{/ifCond}}
                            {{#ifCond this.type 'Poem'}}Poem | കവിത{{/ifCond}}
                            {{#ifCond this.type 'Feature'}}Feature | ലേഖനം{{/ifCond}}
                        </span>
                        <span class="material-symbols-outlined text-secondary opacity-40">
                            {{#ifCond this.type 'Story'}}auto_stories{{/ifCond}}
                            {{#ifCond this.type 'Poem'}}edit_note{{/ifCond}}
                            {{#ifCond this.type 'Feature'}}article{{/ifCond}}
                        </span>
                    </div>
                    <div class="flex-1 relative overflow-hidden">
                        <div id="entry-text-{{@index}}"
                            class="text-lg md:text-xl text-on-surface-variant dark:text-slate-300 leading-relaxed font-['Gayathri'] font-normal {{#ifCond this.type 'Poem'}}text-center italic{{else}}text-justify{{/ifCond}} max-h-[200px] overflow-hidden transition-all duration-500">
                            {{#if this.title}}<h4 class="text-2xl md:text-3xl font-['Manjari'] font-bold mb-3 text-primary dark:text-white">{{this.title}}</h4>{{/if}}
                            <p class="font-normal">{{this.content}}</p>
                        </div>
                        <div id="entry-gradient-{{@index}}"
                            class="absolute bottom-0 left-0 w-full h-16 bg-gradient-to-t from-white dark:from-slate-800 to-transparent pointer-events-none transition-opacity duration-300">
                        </div>
                    </div>

                    <div class="mt-xl pt-lg border-t border-outline-variant/30 flex items-center justify-between">
                        <div>
                            <p class="font-bold text-primary dark:text-white uppercase tracking-wider text-xs">
                                {{this.writerName}}</p>
                            <p class="text-[10px] text-on-surface-variant">{{this.writerDetails}}</p>
                        </div>
                        <a href="/reading-corner"
                            class="w-10 h-10 rounded-full bg-primary/5 dark:bg-white/5 flex items-center justify-center text-primary dark:text-white hover:bg-primary hover:text-white transition-all group-hover:scale-110 shadow-sm">
                            <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
                        </a>
                    </div>

                    <button onclick="toggleDynamicEntry({{@index}}, '{{this.type}}')" id="entry-btn-{{@index}}"
                        class="mt-4 text-primary dark:text-white font-bold text-sm flex items-center gap-xs hover:gap-md transition-all">
                        <span>Read Full {{this.type}}</span>
                        <span
                            class="material-symbols-outlined text-[18px] transition-transform duration-300">arrow_forward</span>
                    </button>
                </div>
                {{else}}
                <div class="col-span-3 text-center py-xl">
                    <p class="text-on-surface-variant italic">Waiting for fresh student creations...</p>
                </div>
                {{/each}}
            </div>
            <div class="mt-xl flex justify-center">
                <a href="/reading-corner"
                    class="px-xl py-md bg-secondary text-on-secondary rounded-full font-label-md text-label-md gold-glow hover:translate-y-[-2px] transition-all flex items-center gap-base active:scale-95">
                    <span>View All Student Works</span>
                    <span class="material-symbols-outlined">arrow_forward</span>
                </a>
            </div>
        </div>
    </section>



    <script>
        function toggleDynamicEntry(index, type) {
            const text = document.getElementById('entry-text-' + index);
            const gradient = document.getElementById('entry-gradient-' + index);
            const btn = document.getElementById('entry-btn-' + index);
            const btnText = btn.querySelector('span');
            const btnIcon = btn.querySelector('.material-symbols-outlined');

            const isExpanded = text.classList.contains('max-h-[1000px]');

            if (isExpanded) {
                text.classList.remove('max-h-[1000px]');
                text.classList.add('max-h-[200px]');
                gradient.style.opacity = '1';
                btnText.textContent = 'Read Full ' + type;
                btnIcon.style.transform = 'rotate(0deg)';
                text.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
                text.classList.remove('max-h-[200px]');
                text.classList.add('max-h-[1000px]');
                gradient.style.opacity = '0';
                btnText.textContent = 'Show Less';
                btnIcon.style.transform = 'rotate(180deg)';
            }
        }

        function shareWork(platform, title, author) {
            const pageUrl = window.location.origin + '/reading-corner';
            const shareTitle = title && title !== 'undefined' ? `"${title}"` : 'a student creation';
            const text = `Check out ${shareTitle} by ${author} in the SIRAJUL IRFAN Writing Corner!\n\nRead it here: ${pageUrl}`;

            let shareUrl = '';
            if (platform === 'whatsapp') {
                shareUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`;
            } else if (platform === 'facebook') {
                shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;
            }

            window.open(shareUrl, '_blank', 'width=600,height=400');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const groups = document.querySelectorAll('.video-category-group');
            groups.forEach(group => {
                const cards = group.querySelectorAll('.video-card');
                if (cards.length === 0) return;

                const isShort = cards[0].getAttribute('data-short') === 'true';
                const limit = isShort ? 5 : 6;

                if (cards.length > limit) {
                    for (let i = limit; i < cards.length; i++) {
                        cards[i].classList.add('hidden');
                    }
                    const btnContainer = group.querySelector('.load-more-container');
                    if (btnContainer) {
                        btnContainer.classList.remove('hidden');
                    }
                }
            });
        });

        function toggleCategoryVideos(button) {
            const group = button.closest('.video-category-group');
            const cards = group.querySelectorAll('.video-card');
            if (cards.length === 0) return;

            const isShort = cards[0].getAttribute('data-short') === 'true';
            const limit = isShort ? 5 : 6;

            const isCollapsed = cards[limit].classList.contains('hidden');
            const btnText = button.querySelector('.btn-text');
            const btnIcon = button.querySelector('.material-symbols-outlined');

            if (isCollapsed) {
                for (let i = limit; i < cards.length; i++) {
                    cards[i].classList.remove('hidden');
                }
                btnText.textContent = 'Show Less';
                btnIcon.textContent = 'expand_less';
            } else {
                for (let i = limit; i < cards.length; i++) {
                    cards[i].classList.add('hidden');
                }
                btnText.textContent = 'View All';
                btnIcon.textContent = 'expand_more';

                group.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }
    </script>

    <!-- Youtube Videos Section -->
