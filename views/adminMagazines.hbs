{{> adminHeader}}

<div class="flex w-full">
    <main class="pt-24 pb-12 px-4 sm:px-10 min-h-screen bg-[#f8faff] w-full">
        <div class="max-w-6xl mx-auto">
            <header class="mb-10">
                <a href="/admin" class="inline-flex items-center gap-2 text-sm font-bold text-gray-500 hover:text-[#001b3d] mb-4 transition-colors">
                    <span class="material-symbols-outlined text-lg">arrow_back</span>
                    Back to Dashboard
                </a>
                <nav class="flex items-center gap-2 text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">
                    <a href="/admin" class="hover:text-[#001b3d]">Admin</a>
                    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                    <span class="text-[#001b3d]">Heyzine Digital Magazines</span>
                </nav>
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <h1 class="text-3xl font-bold text-[#001b3d] leading-tight">Digital Magazines & Reports</h1>
                        <p class="text-gray-500 font-medium mt-2 text-sm">Live sync with Heyzine API endpoint. Flipbooks are automatically loaded and sorted in chronological order.</p>
                    </div>
                    <a href="https://heyzine.com" target="_blank" class="px-6 py-3.5 bg-[#001b3d] text-white font-bold rounded-2xl shadow-md hover:bg-opacity-95 transition-all flex items-center gap-2 text-sm">
                        <span class="material-symbols-outlined text-lg text-amber-400">open_in_new</span>
                        Open Heyzine Dashboard
                    </a>
                </div>
            </header>

            <!-- Heyzine API Status Card -->
            <div class="bg-white rounded-3xl border border-gray-100 p-8 mb-10 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-amber-400/10 rounded-full blur-2xl -mr-10 -mt-10 pointer-events-none"></div>
                <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-[#001b3d] text-[#fcd34d] flex items-center justify-center shadow-lg">
                            <span class="material-symbols-outlined text-3xl">api</span>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-xl font-extrabold text-[#001b3d]">Heyzine API Live Synchronization</h2>
                                <span class="px-3 py-1 bg-emerald-100 text-emerald-800 text-[11px] font-bold rounded-full flex items-center gap-1">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                    Active API
                                </span>
                            </div>
                            <p class="text-xs text-gray-500 font-medium mt-1">Manual database forms removed. Flipbooks are fetched live via Heyzine API and displayed chronologically in the carousel.</p>
                        </div>
                    </div>
                    
                    <div class="bg-[#f8faff] px-5 py-3 rounded-2xl border border-gray-200/80 flex items-center gap-4 text-xs font-bold text-[#001b3d]">
                        <div>
                            <span class="text-gray-400 uppercase text-[10px] block">Live Endpoint</span>
                            <span>heyzine.com/api1/flipbook-list</span>
                        </div>
                        <div class="h-6 w-px bg-gray-200"></div>
                        <div>
                            <span class="text-gray-400 uppercase text-[10px] block">Total Flipbooks</span>
                            <span class="text-amber-600 text-sm font-black">{{magazines.length}}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Published Live Magazines Table -->
            <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden mb-12">
                <div class="p-8 border-b border-gray-50 flex items-center justify-between">
                    <h2 class="text-lg font-bold text-[#001b3d] flex items-center gap-3">
                        Live Synced Magazines & Souvenirs
                        <span class="px-3 py-1 bg-[#fcd34d]/30 text-[#001b3d] text-[10px] font-extrabold rounded-full uppercase tracking-tighter">{{magazines.length}} SYNCED</span>
                    </h2>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-[#fafbfc] border-b border-gray-50">
                            <tr>
                                <th class="px-6 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Cover</th>
                                <th class="px-6 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Title & Details</th>
                                <th class="px-6 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Live Embed Link</th>
                                <th class="px-6 py-5 text-[10px] font-bold text-gray-400 uppercase tracking-widest text-right">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            {{#each magazines}}
                            <tr class="hover:bg-[#fcfdfe] transition-colors group">
                                <td class="px-6 py-6">
                                    <div class="w-16 h-12 bg-gray-100 rounded-xl overflow-hidden border border-gray-200 shadow-sm relative">
                                        <img src="{{#if this.coverImage}}{{this.coverImage}}{{else}}/images/CAC02790.JPG{{/if}}" class="w-full h-full object-cover" alt="{{this.title}}">
                                    </div>
                                </td>
                                <td class="px-6 py-6">
                                    <h4 class="font-bold text-[#001b3d] text-base mb-1">{{this.title}}</h4>
                                    <p class="text-xs text-gray-400 font-medium line-clamp-2">{{#if this.description}}{{this.description}}{{else}}Synced from Heyzine account{{/if}}</p>
                                </td>
                                <td class="px-6 py-6">
                                    <a href="{{this.embedUrl}}" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-50 text-amber-700 hover:bg-amber-100 rounded-lg text-xs font-bold transition-colors">
                                        <span class="material-symbols-outlined text-sm">open_in_new</span> View Flipbook
                                    </a>
                                </td>
                                <td class="px-6 py-6 text-right">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Live Synced
                                    </span>
                                </td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="5" class="px-8 py-20 text-center">
                                    <div class="flex flex-col items-center gap-4 opacity-40">
                                        <span class="material-symbols-outlined text-6xl text-[#001b3d]">menu_book</span>
                                        <p class="text-lg font-bold text-[#001b3d]">No flipbooks retrieved from Heyzine API.</p>
                                        <p class="text-xs text-gray-500">Upload flipbooks in your Heyzine account to display them here.</p>
                                    </div>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>

            {{> adminFooter}}
        </div>
    </main>
</div>
