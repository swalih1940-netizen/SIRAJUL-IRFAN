{{> adminHeader}}

<main class="pt-8 pb-12 min-h-screen bg-[#f8faff] w-full">
    <div class="px-4 sm:px-10 py-6 sm:py-10">
        <header class="flex flex-col md:flex-row md:items-center justify-between mb-12 gap-6">
            <div>
                <a href="/admin" class="inline-flex items-center gap-2 text-sm font-bold text-gray-500 hover:text-[#001b3d] mb-4 transition-colors">
                    <span class="material-symbols-outlined text-lg">arrow_back</span>
                    Back to Dashboard
                </a>
                <h1 class="text-[32px] font-bold text-[#001b3d] leading-tight tracking-tight">Messages Dashboard</h1>
                <p class="text-gray-400 mt-2 text-[15px]">View and manage messages sent by visitors through the contact form.</p>
            </div>
        </header>

        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="p-8 border-b border-gray-50 flex justify-between items-center">
                <div>
                    <h3 class="text-xl font-bold text-[#001b3d]">Recent Messages</h3>
                    <p class="text-sm text-gray-400 mt-1">Manage your communications with the public</p>
                </div>
                <span class="px-5 py-2 bg-[#f0f4f9] text-[#001b3d] font-bold rounded-xl text-xs">Total: {{messages.length}}</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="bg-[#fafbfc] border-b border-gray-50">
                            <th class="px-8 py-5 text-[12px] font-bold text-gray-400 uppercase tracking-widest">Sender Details</th>
                            <th class="px-8 py-5 text-[12px] font-bold text-gray-400 uppercase tracking-widest">Message Content</th>
                            <th class="px-8 py-5 text-[12px] font-bold text-gray-400 uppercase tracking-widest">Date Received</th>
                            <th class="px-8 py-5 text-[12px] font-bold text-gray-400 uppercase tracking-widest text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        {{#each messages}}
                        <tr class="group hover:bg-[#f8faff] transition-colors">
                            <td class="px-8 py-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-xl bg-[#f0f4f9] text-[#001b3d] flex items-center justify-center font-bold">
                                        {{substring this.firstName 0 1}}{{substring this.lastName 0 1}}
                                    </div>
                                    <div>
                                        <p class="font-bold text-[#001b3d]">{{this.firstName}} {{this.lastName}}</p>
                                        <p class="text-[11px] text-gray-400 font-bold">{{this.email}}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                <div class="max-w-md">
                                    <p class="text-sm text-gray-600 line-clamp-2" title="{{this.message}}">{{this.message}}</p>
                                </div>
                            </td>
                            <td class="px-8 py-6 text-sm text-gray-500">
                                {{formatDate this.submittedAt}}
                            </td>
                            <td class="px-8 py-6 text-right">
                                <div class="flex items-center justify-end gap-3">
                                    <button onclick="viewMessage('{{this.firstName}} {{this.lastName}}', '{{this.email}}', '{{this.message}}', '{{this.submittedAt}}')" 
                                            class="w-10 h-10 rounded-xl border border-gray-100 flex items-center justify-center text-gray-400 hover:text-[#001b3d] hover:bg-white hover:shadow-sm transition-all">
                                        <span class="material-symbols-outlined text-xl">visibility</span>
                                    </button>
                                    <form action="/admin/messages/delete/{{this._id}}" method="POST" onsubmit="return confirm('Permanently delete this message?');">
                                        <button type="submit" class="w-10 h-10 rounded-xl border border-gray-100 flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 transition-all">
                                            <span class="material-symbols-outlined text-xl">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="4" class="px-8 py-20 text-center">
                                <span class="material-symbols-outlined text-[64px] text-gray-200 mb-4 block">mail_outline</span>
                                <p class="text-gray-400 italic font-medium">No messages found in your inbox.</p>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {{> adminFooter}}
</main>

<!-- Message Detail Modal -->
<div id="message-modal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-6 bg-[#001b3d]/60 backdrop-blur-sm">
    <div class="bg-white w-full max-w-xl rounded-3xl p-10 shadow-2xl relative animate-in fade-in zoom-in duration-300">
        <button onclick="document.getElementById('message-modal').classList.add('hidden')" class="absolute right-8 top-8 text-gray-400 hover:text-[#001b3d] transition-colors">
            <span class="material-symbols-outlined text-3xl">close</span>
        </button>
        
        <div class="mb-10">
            <div class="flex items-center gap-6 mb-10">
                <div id="modal-initials" class="w-20 h-20 rounded-2xl bg-[#001b3d] text-white flex items-center justify-center font-bold text-3xl shadow-lg">??</div>
                <div>
                    <h3 id="modal-sender" class="text-2xl font-bold text-[#001b3d]">Sender Name</h3>
                    <p id="modal-email" class="text-sm font-bold text-yellow-600 mt-1 uppercase tracking-widest">email@example.com</p>
                </div>
            </div>
            
            <div class="bg-[#f8faff] p-8 rounded-2xl border border-gray-100 min-h-[150px]">
                <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest block mb-4 border-b border-gray-100 pb-2">Message Content</label>
                <p id="modal-content" class="text-base text-[#001b3d] leading-relaxed whitespace-pre-line">-</p>
            </div>
            
            <p id="modal-date" class="text-[10px] text-gray-400 mt-4 text-right font-bold uppercase tracking-widest">-</p>
        </div>
        
        <div class="flex gap-4">
            <a id="modal-reply-btn" href="#" class="flex-1 bg-[#001b3d] text-white py-4 rounded-xl font-bold shadow-lg hover:shadow-[#001b3d]/20 transition-all active:scale-95 text-center flex items-center justify-center gap-3">
                <span class="material-symbols-outlined">reply</span> Reply via Email
            </a>
            <button onclick="document.getElementById('message-modal').classList.add('hidden')" class="flex-1 bg-gray-100 text-gray-500 py-4 rounded-xl font-bold hover:bg-gray-200 transition-all">Close</button>
        </div>
    </div>
</div>

<script>
function viewMessage(name, email, content, date) {
    document.getElementById('modal-sender').innerText = name;
    document.getElementById('modal-email').innerText = email;
    document.getElementById('modal-content').innerText = content;
    document.getElementById('modal-date').innerText = "Received: " + new Date(date).toLocaleString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    document.getElementById('modal-initials').innerText = name.split(' ').map(n => n[0]).join('').toUpperCase();
    document.getElementById('modal-reply-btn').href = "mailto:" + email;
    
    document.getElementById('message-modal').classList.remove('hidden');
}
</script>

{{! Footer moved inside main }}
