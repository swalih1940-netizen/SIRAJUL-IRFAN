{{> header}}
<main class="pt-32 sm:pt-40 pb-xl bg-surface-container-lowest dark:bg-slate-900">
    <!-- Header Section -->
    <div class="relative py-24 bg-[#001b3d] overflow-hidden rounded-[32px] mx-4 sm:mx-10 mb-20 reveal">
        <div class="absolute inset-0 opacity-20">
            <div class="absolute inset-0 bg-gradient-to-br from-secondary/20 to-transparent"></div>
        </div>
        <div class="relative max-w-4xl mx-auto px-6 text-center">
            <span
                class="inline-block px-4 py-1 bg-secondary text-[#001b3d] rounded-full font-bold text-[10px] uppercase tracking-widest mb-8">
                STUDENT PUBLICATION
            </span>
            <h1 class="text-5xl md:text-7xl font-bold text-white mb-8 leading-tight tracking-tight">
                Reading Corner Archive
            </h1>
            <p class="text-xl text-blue-100/60 max-w-2xl mx-auto mb-0 leading-relaxed">
                A dedicated space celebrating the literary creativity, wisdom, and reflections of our students.
            </p>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="max-w-container-max mx-auto px-gutter">
        <!-- Section: Featured student works -->
        <div class="mb-2xl">
            <div class="flex items-center gap-md mb-xl">
                <div class="h-px flex-1 bg-outline-variant/30"></div>
                <h2 class="font-display-lg text-headline-sm text-primary dark:text-white uppercase tracking-[0.3em]">
                    Featured Pieces</h2>
                <div class="h-px flex-1 bg-outline-variant/30"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                {{#each readingEntries}}
                <div
                    class="bg-white p-10 rounded-[32px] border border-gray-100 shadow-xl border-t-4 border-secondary flex flex-col h-full group hover:-translate-y-2 transition-all duration-500">
                    <div class="flex items-center justify-between mb-10">
                        <span
                            class="px-4 py-1.5 {{#ifCond this.type 'Story'}}bg-primary/5 text-primary{{/ifCond}} {{#ifCond this.type 'Poem'}}bg-secondary/10 text-secondary{{/ifCond}} {{#ifCond this.type 'Feature'}}bg-blue-50 text-blue-600{{/ifCond}} text-[9px] font-bold uppercase tracking-widest rounded-lg">
                            {{#ifCond this.type 'Story'}}Story | കഥ{{/ifCond}}
                            {{#ifCond this.type 'Poem'}}Poem | കവിത{{/ifCond}}
                            {{#ifCond this.type 'Feature'}}Feature | ലേഖനം{{/ifCond}}
                        </span>
                        <span class="material-symbols-outlined text-secondary text-2xl opacity-30">
                            {{#ifCond this.type 'Story'}}auto_stories{{/ifCond}}
                            {{#ifCond this.type 'Poem'}}edit_note{{/ifCond}}
                            {{#ifCond this.type 'Feature'}}article{{/ifCond}}
                        </span>
                    </div>
                    <div class="flex-1">
                        <div
                            class="text-xl text-primary leading-relaxed font-['Gayathri'] {{#ifCond this.type 'Poem'}}text-center italic{{else}}text-justify{{/ifCond}}">
                            {{#if this.title}}<h4 class="text-2xl font-bold mb-6 text-[#001b3d]">{{this.title}}</h4>
                            {{/if}}
                            <p class="opacity-70">{{this.content}}</p>
                        </div>
                    </div>
                    <div class="mt-12 pt-10 border-t border-gray-50 flex items-center justify-between">
                        <div>
                            <p class="font-bold text-[#001b3d] uppercase tracking-widest text-xs">{{this.writerName}}
                            </p>
                            <p class="text-[10px] text-gray-400 font-medium mt-1">{{this.writerDetails}}</p>
                        </div>
                        <div class="w-12 h-12 rounded-2xl bg-[#f8faff] flex items-center justify-center">
                            <span class="material-symbols-outlined text-xl text-secondary">person</span>
                        </div>
                    </div>
                    <!-- Social Sharing -->
                    <div class="mt-8 pt-8 border-t border-gray-50 flex items-center gap-4">
                        <span class="text-[9px] text-gray-300 font-bold uppercase tracking-widest">Share:</span>
                        <button onclick="shareWork('whatsapp', '{{this.title}}', '{{this.writerName}}')"
                            class="w-8 h-8 rounded-full bg-green-50 text-green-600 flex items-center justify-center hover:bg-green-600 hover:text-white transition-all shadow-sm">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72 1.171 3.753 1.79 5.823 1.791h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                            </svg>
                        </button>
                        <button onclick="shareWork('facebook', '{{this.title}}', '{{this.writerName}}')"
                            class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center hover:bg-blue-600 hover:text-white transition-all shadow-sm">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                <path
                                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                            </svg>
                        </button>
                    </div>
                </div>
                {{else}}
                <div class="col-span-3 text-center py-32">
                    <span class="material-symbols-outlined text-[80px] text-gray-200 mb-8">auto_stories</span>
                    <p class="text-gray-400 italic font-medium">The archive is currently empty. Check back soon for
                        student works!</p>
                </div>
                {{/each}}
            </div>
        </div><br>
    </div>
    <!-- Back to Home -->
    <div class="mt-2xl flex flex-col sm:flex-row justify-center items-center gap-md">
        <a href="/"
            class="w-full sm:w-auto px-xl py-md bg-surface-container-high text-primary rounded-full font-label-md text-label-md shadow-lg hover:-translate-y-1 transition-all flex items-center justify-center gap-base">
            <span class="material-symbols-outlined">arrow_back</span>
            <span>Back to Home</span>
        </a>

    </div>

    <!-- Section: Submission Form -->

    </div>
</main>
{{> footer}}

<script>
    function shareWork(platform, title, author) {
        const pageUrl = window.location.href;
        const shareTitle = title && title !== 'undefined' ? `"${title}"` : 'a student creation';
        const text = `Check out ${shareTitle} by ${author} in the SIRAJUL IRFAN Reading Corner!\n\nRead it here: ${pageUrl}`;

        let shareUrl = '';
        if (platform === 'whatsapp') {
            shareUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`;
        } else if (platform === 'facebook') {
            shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;
        }

        window.open(shareUrl, '_blank', 'width=600,height=400');
    }
</script>