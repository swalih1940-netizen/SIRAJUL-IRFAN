                        <div>
                            <h3 class="font-headline-sm text-headline-sm text-primary dark:text-white mb-sm">Visit Our
                                Campus</h3>
                            <p class="text-body-md text-on-surface-variant dark:text-slate-300">SISA Campus, Perimbalam,
                                Manjeri</p>
                            <a href="https://maps.app.goo.gl/Ckqmjmk1WrqCD3K48" target="_blank"
                                class="mt-sm text-secondary dark:text-amber-400 font-label-md text-label-md hover:underline decoration-2 underline-offset-4 inline-flex items-center gap-xs font-bold transition-colors">
                                <span class="material-symbols-outlined text-[18px] text-secondary dark:text-amber-400">directions</span>
                                Get Directions
                            </a>
                        </div>
                        <div>
                            <h3 class="font-headline-sm text-headline-sm text-primary dark:text-white mb-sm">Document
                                Verification
                            </h3>
                            <p class="text-body-md text-on-surface-variant dark:text-slate-300">
                                sirajulirfan.com/admission
                            </p>
                            <p class="text-body-sm text-on-tertiary-container mt-xs">Average response time: 24-48 hours
                            </p>
                        </div>
                    </div>
                </section>
</main>

<script>
    // Reveal Animation
    const observerOptions = {
        threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
            }
        });
    }, observerOptions);

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // Save as Draft Functionality
    const form = document.getElementById('admission-form');
    const saveBtn = document.getElementById('save-draft-btn');

    // Load draft on page load
    window.addEventListener('DOMContentLoaded', () => {
        const savedDraft = localStorage.getItem('admission_draft');
        if (savedDraft) {
            const data = JSON.parse(savedDraft);
            Object.keys(data).forEach(key => {
                const field = form.elements[key];
                if (field) {
                    if (field.type === 'checkbox') {
                        field.checked = data[key];
                    } else {
                        field.value = data[key];
                    }
                }
            });
            showToast('Draft loaded successfully!');
        }
    });

    // Save draft on button click
    saveBtn.addEventListener('click', () => {
        const formData = new FormData(form);
        const data = {};
        formData.forEach((value, key) => {
            data[key] = value;
        });

        // Handle checkboxes separately since FormData only includes checked ones
        const checkboxes = form.querySelectorAll('input[type="checkbox"]');
        checkboxes.forEach(cb => {
            data[cb.name] = cb.checked;
        });

        localStorage.setItem('admission_draft', JSON.stringify(data));
        showToast('Draft saved to local storage.');
    });

    // Simple Toast Notification
    function showToast(message) {
        const toast = document.createElement('div');
        toast.className = 'fixed bottom-8 left-1/2 -translate-x-1/2 bg-primary text-white px-lg py-sm rounded-full shadow-2xl z-[100] transition-all duration-500 transform translate-y-20 opacity-0 flex items-center gap-sm';
        toast.innerHTML = `<span class="material-symbols-outlined text-secondary">info</span><span>${message}</span>`;
        document.body.appendChild(toast);

        // Animate in
        setTimeout(() => {
            toast.classList.remove('translate-y-20', 'opacity-0');
        }, 100);

        // Animate out
        setTimeout(() => {
            toast.classList.add('translate-y-20', 'opacity-0');
            setTimeout(() => toast.remove(), 500);
        }, 3000);
    }
</script>

<!-- Status Check Modal -->
<div id="status-modal"
    class="fixed inset-0 z-[100] hidden flex items-center justify-center p-md bg-primary/40 backdrop-blur-sm">
    <div class="bg-white dark:bg-slate-800 w-full max-w-md rounded-2xl p-lg shadow-2xl relative reveal">
        <button onclick="document.getElementById('status-modal').classList.add('hidden')"
            class="absolute right-md top-md text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
        <h3 class="font-headline-md text-headline-md text-primary dark:text-white mb-md">Application Status</h3>
        <p class="text-body-md text-on-surface-variant dark:text-slate-400 mb-lg">Enter your WhatsApp number to check
            your current enrollment status.</p>

        <form action="/admission/status" method="POST" class="space-y-md">
            <div class="space-y-xs">
                <label class="font-label-md text-label-md text-on-surface-variant dark:text-slate-300">WhatsApp
                    Number</label>
                <input
                    class="w-full bg-surface-container dark:bg-slate-900 p-md rounded-lg border-none focus:ring-2 focus:ring-secondary transition-all dark:text-white"
                    placeholder="+91 00000 00000" type="tel" name="whatsappNumber" required />
            </div>
            <button type="submit"
                class="w-full bg-primary text-white py-md rounded-lg font-headline-sm text-headline-sm hover:shadow-xl transition-all active:scale-95">Check
                Status</button>
        </form>
    </div>
</div>

{{#if statusResult}}
<div id="result-modal"
    class="fixed inset-0 z-[110] flex items-center justify-center p-md bg-primary/60 backdrop-blur-md">
    <div class="bg-white dark:bg-slate-800 w-full max-w-md rounded-2xl p-lg shadow-2xl relative">
        <button onclick="document.getElementById('result-modal').remove()"
            class="absolute right-md top-md text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
        <div class="text-center">
            <div
                class="w-16 h-16 bg-secondary/10 text-secondary rounded-full flex items-center justify-center mx-auto mb-md">
                <span class="material-symbols-outlined text-display-sm">verified</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-primary dark:text-white mb-sm">Status Found</h3>
            <div class="bg-surface-container dark:bg-slate-900 p-md rounded-xl text-left mb-lg">
                <div class="flex justify-between mb-xs">
                    <span class="text-body-sm text-on-surface-variant">Name:</span>
                    <span class="text-body-sm font-bold text-primary dark:text-white">{{statusResult.fullName}}</span>
                </div>
                <div class="flex justify-between mb-xs">
                    <span class="text-body-sm text-on-surface-variant">Application ID:</span>
                    <span class="text-body-sm font-mono text-secondary">#ADM-{{statusResult.id}}</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-body-sm text-on-surface-variant">Status:</span>
                    <span
                        class="px-2 py-0.5 bg-yellow-100 text-yellow-700 text-[10px] rounded font-bold uppercase tracking-widest">Pending
                        Review</span>
                </div>
            </div>
            <p class="text-body-sm text-on-surface-variant dark:text-slate-400">Our admissions team is currently
                reviewing your documents. You will receive a WhatsApp message once the verification is complete.</p>
        </div>
    </div>
</div>
{{/if}}

{{#if statusError}}
<div id="error-modal"
    class="fixed inset-0 z-[110] flex items-center justify-center p-md bg-primary/60 backdrop-blur-md">
    <div class="bg-white dark:bg-slate-800 w-full max-w-md rounded-2xl p-lg shadow-2xl relative">
        <button onclick="document.getElementById('error-modal').remove()"
            class="absolute right-md top-md text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
        <div class="text-center">
            <div class="w-16 h-16 bg-error/10 text-error rounded-full flex items-center justify-center mx-auto mb-md">
                <span class="material-symbols-outlined text-display-sm">warning</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-error mb-sm">Record Not Found</h3>
            <p class="text-body-md text-on-surface-variant dark:text-slate-400 mb-lg">We couldn't find any application
                associated with <strong>{{statusError}}</strong>.</p>
            <button onclick="document.getElementById('error-modal').remove()"
                class="w-full bg-surface-container-highest text-primary py-md rounded-lg font-headline-sm">Close and Try
                Again</button>
        </div>
    </div>
</div>
{{/if}}

{{> footer}}