{{> header}}

<main class="min-h-screen pt-24 pb-16 bg-surface dark:bg-slate-900">
    <div class="max-w-container-max mx-auto px-gutter">
        
        <!-- Header -->
        <div class="text-center mb-16 reveal active">
            <span class="text-secondary font-label-md text-label-md tracking-wider uppercase mb-sm block">Visual Journey</span>
            <h1 class="text-4xl md:text-5xl font-display-lg text-primary dark:text-white font-bold mb-4">Our Album</h1>
            <p class="text-body-lg text-on-surface-variant dark:text-slate-400 max-w-2xl mx-auto">
                Explore memories, events, and the vibrant campus life at Sirajul Irfan.
            </p>
        </div>

        <!-- Masonry Gallery -->
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 md:gap-6 space-y-4 md:space-y-6">
            {{#each photos}}
            <div class="relative group rounded-2xl overflow-hidden premium-shadow reveal active cursor-pointer break-inside-avoid" onclick="openImageModal('{{this.imageUrl}}')">
                <img src="{{this.imageUrl}}" alt="Gallery image{{#if this.albumName}} from {{this.albumName}}{{/if}} - {{this.description}} - [Institution Name]" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700 ease-in-out">
                
                {{#if this.description}}
                <div class="absolute bottom-0 left-0 w-full p-4 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                    <p class="text-white text-sm font-medium">{{this.description}}</p>
                </div>
                {{/if}}
                <div class="absolute inset-0 bg-primary/20 opacity-0 group-hover:opacity-100 transition-all flex items-center justify-center pointer-events-none">
                    <div class="bg-white/20 backdrop-blur-md text-white p-3 rounded-full shadow-2xl scale-0 group-hover:scale-100 transition-all duration-500">
                        <span class="material-symbols-outlined">zoom_in</span>
                    </div>
                </div>
            </div>
            {{else}}
            <div class="w-full text-center py-12 text-on-surface-variant dark:text-slate-400">
                <p>No photos have been uploaded to the album yet.</p>
            </div>
            {{/each}}
        </div>

    </div>
    {{> imageModal}}
</main>

{{> footer}}
