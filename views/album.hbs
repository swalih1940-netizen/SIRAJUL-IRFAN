{{> header}}

<main class="min-h-screen pt-24 pb-16 bg-surface dark:bg-slate-900">
    <div class="max-w-container-max mx-auto px-gutter">
        
        <!-- Header -->
        <div class="text-center mb-16 reveal active">
            <span class="text-secondary font-label-md text-label-md tracking-wider uppercase mb-sm block">Visual Journey</span>
            <h1 class="text-4xl md:text-5xl font-display-lg text-primary dark:text-white font-bold mb-4">Our Album</h1>
            <p class="text-body-lg text-on-surface-variant dark:text-slate-400 max-w-2xl mx-auto">
                Explore memories, events, and the vibrant campus life at Sirajul Irfan.
            </p>
        </div>

        <!-- Masonry Grid Gallery -->
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
            {{#each photos}}
            <div class="break-inside-avoid relative group rounded-2xl overflow-hidden premium-shadow reveal active">
                <img src="{{this.imageUrl}}" alt="{{this.description}}" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700 ease-in-out">
                
                {{#if this.description}}
                <div class="absolute bottom-0 left-0 w-full p-4 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <p class="text-white text-sm font-medium">{{this.description}}</p>
                </div>
                {{/if}}
            </div>
            {{else}}
            <div class="col-span-full text-center py-12 text-on-surface-variant dark:text-slate-400">
                <p>No photos have been uploaded to the album yet.</p>
            </div>
            {{/each}}
        </div>

    </div>
</main>

{{> footer}}
